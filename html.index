<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Spine Study Atlas</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap">
<style>
/* Layout: sticky section chips, dense auto-fill card grid, bottom tab bar for phones. */
:root{--bg:#f2f4f7;--surface:#fff;--ink:#17202b;--mute:#566274;--line:#dde2e9;--red:#d14646;--blue:#2c68c9;--grn:#1d8a5f;--org:#c97712;--onk:#fff;--key:#fff3cf;--keyink:#4a3600;--tint:rgba(100,116,139,.12);--fd:"Space Grotesk","Inter",-apple-system,"Segoe UI",sans-serif;--fb:"Inter",-apple-system,"Segoe UI",Helvetica,Arial,sans-serif}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1218;--surface:#19202a;--ink:#eaeef4;--mute:#9aa6b6;--line:#2a3340;--red:#f07b7b;--blue:#79a9f5;--grn:#4cc79a;--org:#f2ac52;--onk:#0e1218;--key:#3a3115;--keyink:#ffe9a8;--tint:rgba(148,163,184,.16);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e1218;--surface:#19202a;--ink:#eaeef4;--mute:#9aa6b6;--line:#2a3340;--red:#f07b7b;--blue:#79a9f5;--grn:#4cc79a;--org:#f2ac52;--onk:#0e1218;--key:#3a3115;--keyink:#ffe9a8;--tint:rgba(148,163,184,.16);color-scheme:dark}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:15px;line-height:1.4;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:12px 96px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
main{max-width:1240px;margin:0 auto}
svg{display:block;max-width:100%;height:auto}
h1,h2{font-family:var(--fd);text-wrap:balance}
.hero{padding:10px 0 4px}
.hero h1{font-size:clamp(26px,5vw,38px);line-height:1.08;margin:0 0 6px}
.hero p{margin:0;color:var(--mute);max-width:70ch}
.search{margin:12px 0 4px}
.search input{width:100%;font:inherit;font-size:16px;padding:11px 14px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
.chipnav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);display:flex;gap:8px;overflow-x:auto;padding:8px 0;margin:0 -2px;scrollbar-width:none}
.chipnav::-webkit-scrollbar{display:none}
.chipnav button{flex:0 0 auto;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:inherit;font-weight:600;font-size:13px;padding:7px 12px;border-radius:99px;cursor:pointer;border-left:5px solid var(--k)}
.sec{margin:22px 0 8px;scroll-margin-top:60px}
.sec>header{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;border-bottom:3px solid var(--k);padding-bottom:6px;margin-bottom:10px}
.sec h2{margin:0;font-size:clamp(20px,3.4vw,26px);color:var(--k)}
.sec .cnt{font-size:13px;color:var(--mute);font-weight:600}
.hooks{display:grid;gap:8px;margin-bottom:12px}
.hook{background:var(--key);color:var(--keyink);border-radius:12px;padding:9px 12px;font-size:14px;line-height:1.4}
.hook::before{content:"MEMORY HOOK";display:block;font-size:10.5px;font-weight:800;letter-spacing:.08em;opacity:.75;margin-bottom:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr));gap:12px;align-items:start}
.card{background:var(--surface);border:1px solid var(--line);border-top:5px solid var(--k);border-radius:14px;padding:12px 13px 13px;min-width:0;overflow-wrap:anywhere}
.card h2{font-size:17px;line-height:1.15;margin:0 0 2px;color:var(--k)}
.card .small{font-size:12.5px;color:var(--mute);margin:2px 0 6px;line-height:1.3}
.card .in{display:block}
.fig{margin:8px 0;background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow:hidden}
.fig img{display:block;width:100%;height:auto;background:#000}
.fig figcaption{background:var(--tint);color:var(--ink);font-size:11.5px;line-height:1.3;padding:6px 9px}
.pts{list-style:none;margin:6px 0 0;padding:0}
.pts li{position:relative;padding-left:16px;margin:5px 0;font-size:14.5px;line-height:1.38}
.pts li::before{content:"";position:absolute;left:2px;top:.52em;width:7px;height:7px;border-radius:50%;background:var(--k)}
.pts li.sub{margin-left:14px;color:var(--mute);font-size:13.5px}
.pts li.sub::before{width:5px;height:5px;left:3px}
.pts b{color:var(--k)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.chip{background:var(--k);color:var(--onk);border-radius:99px;padding:3px 11px;font-size:12.5px;font-weight:700;line-height:1.3}
.boxes{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.box{flex:1 1 90px;min-width:0;border-radius:11px;padding:8px 7px;color:var(--onk);text-align:center;font-weight:800;font-size:15px;line-height:1.15}
.box small{display:block;font-size:12px;font-weight:600;margin-top:4px;line-height:1.25}
.box small b{color:inherit}
.rc{display:flex;flex-wrap:wrap;gap:8px;margin:7px 0}
.rc .nm{flex:0 0 100%;background:var(--c);color:var(--onk);border-radius:9px;padding:5px 10px;font-size:13.5px;font-weight:800;line-height:1.2}
.rc .tx{flex:1 1 100%;min-width:0;font-size:14px;font-weight:600;line-height:1.35}
.rc .tx em{display:block;font-style:normal;font-weight:500;color:var(--mute);font-size:13px;margin-top:1px}
.grp{margin:7px 0}
.grp .gn{background:var(--c);color:var(--onk);border-radius:9px;padding:4px 9px;font-weight:800;font-size:12.5px;line-height:1.2;display:inline-block;margin-bottom:5px}
.grp .gi{display:flex;flex-wrap:wrap;gap:5px}
.it{background:var(--tint);border-radius:9px;padding:2px 3px 2px 8px;font-size:12.5px;font-weight:600;display:inline-flex;align-items:center;gap:6px;line-height:1.25}
.it b{background:var(--c);color:var(--onk);border-radius:7px;min-width:22px;text-align:center;padding:1px 6px;font-size:13px}
.key{background:var(--key);color:var(--keyink);border-radius:10px;padding:8px 10px;margin-top:8px;font-size:13.5px;font-weight:600;line-height:1.38}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(84px,1fr));gap:7px;margin-top:8px}
.stat{background:var(--tint);border-radius:11px;padding:7px 5px;text-align:center}
.stat .n{font-family:var(--fd);font-size:21px;font-weight:700;color:var(--k);line-height:1.1}
.stat .l{font-size:11.5px;color:var(--mute);font-weight:600;line-height:1.2;margin-top:2px}
.side{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:4px}
.side .art{flex:0 0 auto;max-width:42%}
.side .art svg{width:100%}
.side .main{flex:1 1 150px;min-width:0}
.q{font-size:15px;font-weight:600}
.opts{list-style:none;padding:0;margin:6px 0}
/* tabs */
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;gap:6px;justify-content:center;background:var(--surface);border-top:1px solid var(--line);padding:8px max(16px,env(safe-area-inset-right,0px)) calc(8px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.tabs button{flex:1 1 0;max-width:220px;border:0;background:transparent;color:var(--mute);font:inherit;font-weight:700;font-size:13px;padding:9px 6px;border-radius:12px;cursor:pointer}
.tabs button[aria-selected="true"]{background:var(--ink);color:var(--bg)}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
/* flashcards */
.fc{max-width:680px;margin:14px auto}
.fc .bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-bottom:10px}
.fc select{font:inherit;font-size:15px;padding:8px 10px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);max-width:100%}
.fc .meta{font-size:13px;color:var(--mute);font-weight:600;font-variant-numeric:tabular-nums}
.fc .prog{height:6px;border-radius:9px;background:var(--tint);overflow:hidden;margin-bottom:12px}
.fc .prog i{display:block;height:100%;width:0;background:var(--grn)}
.face{background:var(--surface);border:1px solid var(--line);border-top:6px solid var(--k,var(--blue));border-radius:18px;padding:22px 20px;min-height:230px;display:flex;flex-direction:column;justify-content:center;gap:12px;cursor:pointer}
.face .tag{font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--k,var(--blue))}
.face .t{font-family:var(--fd);font-size:clamp(20px,4.5vw,26px);line-height:1.25;font-weight:700}
.face .ans{font-size:clamp(16px,3.8vw,19px);line-height:1.45;border-top:1px dashed var(--line);padding-top:12px}
.face .ans b{color:var(--k,var(--blue))}
.face .hint{font-size:13px;color:var(--mute)}
.rate{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.btn{font:inherit;font-weight:700;font-size:15px;border:0;border-radius:12px;padding:13px 8px;cursor:pointer;color:var(--onk)}
.btn.again{background:var(--red)}.btn.good{background:var(--blue)}.btn.easy{background:var(--grn)}
.btn.plain{background:var(--ink);color:var(--bg)}
.btn.ghost{background:var(--tint);color:var(--ink)}
.show{margin-top:12px}
.done{text-align:center;padding:30px 10px}
/* quiz */
.qz{max-width:720px;margin:14px auto}
.qz .qt{font-size:clamp(16px,3.8vw,19px);font-weight:600;line-height:1.4;margin:6px 0 12px}
.qz .o{display:block;width:100%;text-align:left;font:inherit;font-size:15.5px;padding:12px 14px;margin:7px 0;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
.qz .o.ok{background:var(--grn);color:var(--onk);border-color:transparent}
.qz .o.no{background:var(--red);color:var(--onk);border-color:transparent}
.qz .why{background:var(--key);color:var(--keyink);border-radius:12px;padding:10px 12px;margin:10px 0;font-size:14.5px}
@media (min-width:700px){.rc{flex-wrap:nowrap}.rc .nm{flex:0 0 118px;display:flex;align-items:center}.rc .tx{flex:1 1 auto}}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
<main>
<div id="v-sheets">
 <div class="hero"><h1>Spinal Trauma &amp; Spine</h1><p>Neurosurgery Fundamentals, book pp. 195–226. Every detail of the pages in dense cards, the book’s own figures, memory hooks, 120 flashcards and the book’s 6 questions.</p></div>
 <div class="search"><input id="q" type="search" placeholder="Search all cards (e.g. teardrop, SINS, Denis, OPLL)" aria-label="Search cards"></div>
 <nav class="chipnav" id="chips"><button style="--k:var(--red)" data-s="odo">C2 fractures</button><button style="--k:var(--blue)" data-s="sub">Subaxial cervical injuries (C3–C7)</button><button style="--k:var(--org)" data-s="tl">Thoracic and thoracolumbar trauma</button><button style="--k:var(--grn)" data-s="sac">Sacral fractures and trauma pearls</button><button style="--k:var(--blue)" data-s="deg">Cervical degenerative disease</button><button style="--k:var(--red)" data-s="opll">OPLL (ossified PLL)</button><button style="--k:var(--grn)" data-s="thl">Thoracic and lumbar degenerative disease</button><button style="--k:var(--org)" data-s="neo">Spinal neoplasms</button><button style="--k:var(--red)" data-s="vas">Spinal vascular disorders</button><button style="--k:var(--blue)" data-s="def">Spinal deformity</button><button style="--k:var(--grn)" data-s="inf">Inflammatory disease and infections</button><button style="--k:var(--red)" data-s="ces">Cauda equina and tethered cord</button></nav>
 <section class="sec" id="sec-odo" style="--k:var(--red)"><header><h2>C2 fractures: odontoid, hangman’s</h2><span class="cnt">9 cards · 14 flashcards</span></header><div class="hooks"><div class="hook"><b>I = tip = stable (collar, unless AOD).</b> <b>II = Junction = trouble</b> (most common, nonunion, unstable). <b>III = through the body = stable = collar.</b></div><div class="hook"><b>Hangman’s = Hyperextension.</b> The pars breaks; always check the <b>C1 ring</b> and the <b>C2–C3 disc</b>.</div><div class="hook">Levine–Edwards: <b>more displacement / angulation / facet dislocation = more unstable</b>. I stable → IIa and III highly unstable (III needs surgery).</div></div><div class="grid"><article class="card" style="--k:var(--blue)"><div class="in"><h2>Odontoid (Dens) Fractures</h2><p class="small">10.12.6 · Anderson and D’Alonzo classification (Fig. 10.10)</p><figure class="fig"><img alt="Fig. 10.10 · Anderson and D’Alonzo classification of dens fractures: Types I, II, III." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 10.10 · Anderson and D’Alonzo classification of dens fractures: Types I, II, III.</figcaption></figure><ul class="pts"><li>The <b>most common C2 (axis)</b> fractures: <b>7% to 14%</b> of traumatic cervical spine injuries</li><li>Often present with <b>high cervical pain</b>; mechanism of injury can vary</li><li>The <b>Anderson and D’Alonzo</b> classification is widely used to categorize odontoid fractures</li><li>It helps guide <b>treatment decisions</b> and assess the <b>stability and healing potential</b> of the fracture</li><li>The system divides dens fractures into <b>three types</b>:</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">Type I<small>Tip of the dens</small></div><div class="box" style="--i:1;background:var(--red)">Type II<small>Odontoid meets the vertebral body</small></div><div class="box" style="--i:2;background:var(--blue)">Type III<small>Through the vertebral body</small></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Odontoid Type I</h2><p class="small">Anderson and D’Alonzo · fracture of the tip of the dens (Fig. 10.10)</p><div class="side"><div class="art"><svg width="200" height="150" viewBox="0 0 120 90"><g fill="#e9e4d8" stroke="#8c8472" stroke-width="2.5" stroke-linejoin="round"><rect x="34" y="42" width="34" height="38" rx="8"/><path d="M42 44V18q0-6 6-6h2q6 0 6 6v26z"/><rect x="68" y="48" width="8" height="16"/><path d="M76 46L98 40L110 44L98 54L76 62z"/></g><path class="flash" d="M40 17H60" stroke="#2a9d6f" stroke-width="5" stroke-linecap="round" stroke-dasharray="6 4"/></svg></div><div class="main"><ul class="pts"><li>Involves the <b>tip of the dens</b></li><li>Generally <b>stable</b></li><li>Treated with a <b>collar</b>, <b>unless AOD is present</b></li><li>If AOD is present: management options include <b>surgery</b> or <b>immobilization with a halo or collar</b></li></ul></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Odontoid Type II</h2><p class="small">Anderson and D’Alonzo Type II · occurs where the odontoid meets the vertebral body</p><div class="side"><div class="art"><svg width="200" height="150" viewBox="0 0 120 90"><g fill="#e9e4d8" stroke="#8c8472" stroke-width="2.5" stroke-linejoin="round"><rect x="34" y="42" width="34" height="38" rx="8"/><path d="M42 44V18q0-6 6-6h2q6 0 6 6v26z"/><rect x="68" y="48" width="8" height="16"/><path d="M76 46L98 40L110 44L98 54L76 62z"/></g><path class="flash" d="M36 44H60" stroke="#d94f4f" stroke-width="5" stroke-linecap="round" stroke-dasharray="6 4"/></svg></div><div class="main"><ul class="pts"><li>Occurs where the odontoid <b>meets the vertebral body</b></li><li><b>Most common</b> odontoid fracture</li><li>High rate of <b>nonunion</b></li><li>Generally <b>unstable</b>: surgery or immobilization</li><li>Comminuted fragments = unstable → <b>consider surgery</b></li></ul></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Odontoid Type III</h2><p class="small">Fracture goes through the vertebral body</p><div class="side"><div class="art"><svg width="200" height="150" viewBox="0 0 120 90"><g fill="#e9e4d8" stroke="#8c8472" stroke-width="2.5" stroke-linejoin="round"><rect x="34" y="42" width="34" height="38" rx="8"/><path d="M42 44V18q0-6 6-6h2q6 0 6 6v26z"/><rect x="68" y="48" width="8" height="16"/><path d="M76 46L98 40L110 44L98 54L76 62z"/></g><path class="flash" d="M31 60L70 53" stroke="#2f6fd0" stroke-width="5" stroke-linecap="round" stroke-dasharray="6 4"/></svg></div><div class="main"><ul class="pts"><li>Goes <b>through the vertebral body</b></li><li>Generally <b>stable</b></li><li>Treat with a <b>cervical collar</b></li><li>…unless other injuries make the spine <b>unstable</b></li></ul></div></div><div class="chips"><span class="chip" style="--i:0">II = unstable</span><span class="chip" style="--i:1">III = stable</span></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Hangman’s Fracture</h2><p class="small">10.12.7 · C2 pars interarticularis</p><figure class="fig"><img alt="Fig. 10.11 · Bilateral C2 pars (hangman’s) fracture on CT, axial and sagittal." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 10.11 · Bilateral C2 pars (hangman’s) fracture on CT, axial and sagittal.</figcaption></figure><div class="side"><div class="art"><svg width="200" height="150" viewBox="0 0 120 90"><g fill="#e9e4d8" stroke="#8c8472" stroke-width="2.5" stroke-linejoin="round"><rect x="34" y="42" width="34" height="38" rx="8"/><path d="M42 44V18q0-6 6-6h2q6 0 6 6v26z"/><rect x="68" y="48" width="8" height="16"/><path d="M76 46L98 40L110 44L98 54L76 62z"/></g><path class="flash" d="M72 42V70" stroke="#e08a1e" stroke-width="5" stroke-linecap="round" stroke-dasharray="6 4"/></svg></div><div class="main"><ul class="pts"><li>Vertical or oblique fracture through the <b>C2 pars interarticularis</b></li><li>Disconnects the <b>posterior arch</b> from the vertebral body</li><li>Cause: <b>hyperextension</b> (car accident, diving injury)</li><li>Also check the <b>posterior C1 ring</b> and the <b>C2–C3 disc</b></li></ul></div></div><p class="small" style="margin-top:6px">Fig. 10.11: bilateral C2 pars fracture on CT (axial + sagittal).</p></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Hangman’s: Treatment</h2><ul class="pts"><li>Most <b>isolated</b> fractures: <b>collar</b></li><li><b>Displaced</b>, isolated fractures: <b>halo brace</b></li><li>Surgery may be indicated if:</li><li class=sub>the <b>C2–C3 facets are locked</b>, or</li><li class=sub>other injuries make the spine <b>unstable</b></li></ul><div class="chips"><span class="chip" style="--i:0">Collar</span><span class="chip" style="--i:1">Halo brace</span><span class="chip" style="--i:2">Surgery</span></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Levine &amp; Edwards</h2><p class="small">Classifies hangman’s fractures by severity of fracture + associated displacement; guides treatment</p><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">Type I<small>Minimally displaced</small><small>STABLE</small><small>Treat with immobilization</small></div><div class="box" style="--i:1;background:var(--org)">Type II<small>Displaced with angulation</small><small>UNSTABLE</small><small>May require surgery</small></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Levine &amp; Edwards</h2><p class="small">The severe types</p><div class="boxes"><div class="box" style="--i:0;background:var(--org)">Type IIa<small>Severe angulation, minimal displacement</small><small>HIGHLY UNSTABLE</small><small>Usually requires surgery</small></div><div class="box" style="--i:1;background:var(--red)">Type III<small>Displaced with facet dislocation</small><small>HIGHLY UNSTABLE</small><small>Requires surgical stabilization</small></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Other C2 Fractures</h2><p class="small">10.12.8</p><ul class="pts"><li><b>Isolated, nondisplaced</b> fractures of the C2 <b>lamina</b>, <b>vertebral body</b> and <b>facets</b></li><li>Generally <b>stable</b> and heal in a <b>collar</b></li><li>C2 fracture <b>together with a C1 fracture</b> → careful evaluation for spinal stability</li></ul><div class="chips"><span class="chip" style="--i:0">Lamina</span><span class="chip" style="--i:1">Body</span><span class="chip" style="--i:2">Facets</span></div></div></article></div></section><section class="sec" id="sec-sub" style="--k:var(--blue)"><header><h2>Subaxial cervical injuries (C3–C7)</h2><span class="cnt">13 cards · 19 flashcards</span></header><div class="hooks"><div class="hook"><b>C5–C6</b> is hit most. Three kinds: compression, flexion/extension/distraction, rotation.</div><div class="hook">Stable: <b>wedge, whiplash, unilateral facet fracture</b> (no subluxation). Unstable: <b>burst, teardrop, bilateral facet fracture-dislocation, perched facet</b>.</div><div class="hook">Rule for flex/ext/distraction: <b>PLL fails AND (slip, facet malalignment, &gt;10°, distraction)</b> = unstable.</div></div><div class="grid"><article class="card" style="--k:var(--blue)"><div class="in"><h2>Subaxial Cervical Injuries</h2><p class="small">10.12.9 · C3–C7</p><figure class="fig"><img alt="Fig. 10.12 · Fracture-dislocation injury at C5–C6 on CT." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 10.12 · Fracture-dislocation injury at C5–C6 on CT.</figcaption></figure><div class="side"><div class="art"><svg width="150" height="230" viewBox="0 0 120 130"><rect x="26" y="4" width="54" height="13" rx="4" fill="#e9e4d8" stroke="#8c8472" stroke-width="2"/><rect x="80" y="7" width="14" height="7" rx="3" fill="#e9e4d8" stroke="#8c8472" stroke-width="1.5"/><text x="4" y="14" font-size="9" font-weight="700" fill="#8c8472">C1</text><rect x="30" y="21" width="46" height="13" rx="4" fill="#e9e4d8" stroke="#8c8472" stroke-width="2"/><rect x="76" y="24" width="14" height="7" rx="3" fill="#e9e4d8" stroke="#8c8472" stroke-width="1.5"/><text x="4" y="31" font-size="9" font-weight="700" fill="#8c8472">C2</text><rect x="30" y="38" width="46" height="13" rx="4" fill="#bcd3f3" stroke="#8c8472" stroke-width="2"/><rect x="76" y="41" width="14" height="7" rx="3" fill="#bcd3f3" stroke="#8c8472" stroke-width="1.5"/><text x="4" y="48" font-size="9" font-weight="700" fill="#8c8472">C3</text><rect x="30" y="55" width="46" height="13" rx="4" fill="#bcd3f3" stroke="#8c8472" stroke-width="2"/><rect x="76" y="58" width="14" height="7" rx="3" fill="#bcd3f3" stroke="#8c8472" stroke-width="1.5"/><text x="4" y="65" font-size="9" font-weight="700" fill="#8c8472">C4</text><rect x="30" y="72" width="46" height="13" rx="4" fill="#f5c27a" stroke="#8c8472" stroke-width="2"/><rect x="76" y="75" width="14" height="7" rx="3" fill="#f5c27a" stroke="#8c8472" stroke-width="1.5"/><text x="4" y="82" font-size="9" font-weight="700" fill="#8c8472">C5</text><rect x="30" y="89" width="46" height="13" rx="4" fill="#f5c27a" stroke="#8c8472" stroke-width="2"/><rect x="76" y="92" width="14" height="7" rx="3" fill="#f5c27a" stroke="#8c8472" stroke-width="1.5"/><text x="4" y="99" font-size="9" font-weight="700" fill="#8c8472">C6</text><rect x="30" y="106" width="46" height="13" rx="4" fill="#bcd3f3" stroke="#8c8472" stroke-width="2"/><rect x="76" y="109" width="14" height="7" rx="3" fill="#bcd3f3" stroke="#8c8472" stroke-width="1.5"/><text x="4" y="116" font-size="9" font-weight="700" fill="#8c8472">C7</text></svg></div><div class="main"><ul class="pts"><li>Most commonly injured level: <b>C5–C6</b></li><li>3 kinds: <b>compression</b>, <b>flexion/extension/distraction</b>, <b>rotation</b> (Table 10.4)</li><li>Table covers <b>bony</b> (fracture) and <b>ligamentous</b> (whiplash) injuries</li><li>Fig. 10.12: severe fracture-dislocation</li></ul></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Compression Injuries</h2><p class="small">Table 10.4</p><div class="rc" style="--c:var(--grn);--i:0"><div class="nm">Anterior compression (wedge fracture)</div><div class="tx">Axial loading ± flexion/extension<em>STABLE · generally heal with external immobilization</em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">Comminuted (burst) fracture</div><div class="tx">Axial loading ± flexion<em>Generally UNSTABLE · fusion + decompression if needed</em></div></div><div class="rc" style="--c:var(--red);--i:2"><div class="nm">Teardrop fracture</div><div class="tx">Hyperflexion-compression<em>UNSTABLE · evaluate disc space and ligaments on MRI. Fusion, decompress if needed</em></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Flexion / Extension / Distraction</h2><p class="small">When are these injuries unstable?</p><div class="logic"><div class="lg a">PLL / posterior annulus FAILS</div><div class="and">AND</div></div><div class="chips"><span class="chip" style="--i:0">Anterolisthesis</span><span class="chip" style="--i:1">Facet malalignment</span><span class="chip" style="--i:2">End plate angulation &gt;10°</span><span class="chip" style="--i:3">Vertebral segment distraction</span></div><div class="lg res">= UNSTABLE</div><p class="small" style="margin-top:8px">Book wording: “…AND there is anterolisthesis, facet malalignment, end plate angulation &gt;10 degrees, or vertebral segment distraction.”</p></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Whiplash Injuries</h2><p class="small">Mechanism for both: flexion / extension</p><div class="rc" style="--c:var(--blue);--i:0"><div class="nm">Whiplash with neurologic injury</div><div class="tx">Flexion/extension<em>STABLE · management is controversial; can include a collar and physical therapy</em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">Severe whiplash (sprain)</div><div class="tx">Flexion/extension<em>Re-evaluate integrity of the posterior ligaments · collar, physical therapy</em></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Bilateral Facet Fracture-Dislocation</h2><div class="side"><div class="art"><svg width="190" height="150" viewBox="0 0 120 90"><rect x="30" y="48" width="48" height="26" rx="7" fill="#e9e4d8" stroke="#8c8472" stroke-width="2.5"/><rect x="56" y="14" width="48" height="26" rx="7" fill="#f2c9c9" stroke="#d94f4f" stroke-width="2.5" class="slide"/><path d="M28 27H50" stroke="#d94f4f" stroke-width="3"/><polygon points="50,21 58,27 50,33" fill="#d94f4f"/></svg></div><div class="main"><ul class="pts"><li>Mechanism: <b>distraction + flexion/extension</b> with failure of the <b>posterior ligamentous complex</b></li><li><b>UNSTABLE</b></li><li><b>Closed or open reduction</b> + internal fixation/fusion</li><li>Evaluate for <b>herniated discs</b> with MRI</li></ul></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Unilateral Facet Injuries</h2><p class="small">Mechanism for both: lateral flexion + rotation</p><div class="rc" style="--c:var(--grn);--i:0"><div class="nm">Unilateral facet fracture</div><div class="tx">Lateral flexion + rotation<em>STABLE as long as no significant subluxation, dislocation, or kyphosis · collar</em></div></div><div class="rc" style="--c:var(--red);--i:1"><div class="nm">Unilateral dislocation</div><div class="tx">Lateral flexion + rotation<em>A perched facet is UNSTABLE · evaluate nerve root and cord injury · reduction and halo or fusion</em></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Articular Pillar Separation</h2><p class="small">Fracture separation of the articular pillar</p><ul class="pts"><li>Mechanism: <b>extension, compression + rotation</b></li><li>Evaluate for <b>other injuries</b> to decide if it is stable</li><li>Treatments include <b>collar</b>, <b>halo</b> and <b>surgery</b></li></ul><div class="chips"><span class="chip" style="--i:0">Collar</span><span class="chip" style="--i:1">Halo</span><span class="chip" style="--i:2">Surgery</span></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>SLICS Score</h2><p class="small">Subaxial Cervical Spine Injury Classification System</p><ul class="pts"><li>Tool to assess <b>severity</b> of subaxial fractures (<b>C3–C7</b>)</li><li>Guides treatment: <b>surgical vs nonsurgical</b></li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--blue)">Morphology<small>of the injury</small></div><div class="box" style="--i:1;background:var(--red)">PLC integrity<small>posterior ligamentous complex</small></div><div class="box" style="--i:2;background:var(--org)">Neurological status</div></div><p class="small" style="margin-top:12px">Each factor gets a score; the total score helps determine treatment.</p></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>AO Spine: Subaxial Cervical</h2><p class="small">10.12.9 continued · classifies C3–C7</p><ul class="pts"><li>Based on <b>type of fracture</b>, <b>stability</b> of the spine, and presence of <b>neurological deficits</b></li><li>Helps guide treatment decisions</li><li>Three main injury types:</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">A<small>Compression injuries</small></div><div class="box" style="--i:1;background:var(--org)">B<small>Tension band injuries</small></div><div class="box" style="--i:2;background:var(--red)">C<small>Displacement / translation injuries</small></div></div><ul class="pts"><li>Each type is further subdivided by <b>severity and location</b></li><li>Also considers <b>neurological status</b> and the condition of the <b>PLC</b></li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Jumped Facets</h2><p class="small">10.12.10 · Fig. 10.13: (a) perched, (b) locked facets</p><figure class="fig"><img alt="Fig. 10.13 · (a) Perched facets, (b) locked facets." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 10.13 · (a) Perched facets, (b) locked facets.</figcaption></figure><ul class="pts"><li>Can result in <b>severe injury</b> to the spinal cord and nerve roots</li><li>Facets may be <b>perched</b> or frankly <b>locked</b>, depending on severity of injury</li><li><b>Unilateral</b> injuries: when the spine is <b>rotated</b></li><li><b>Bilateral</b> injuries: usually <b>flexion or extension</b> that disrupts the posterior ligaments</li></ul><div class="chips"><span class="chip" style="--i:0">Perched</span><span class="chip" style="--i:1">Locked</span><span class="chip" style="--i:2">Unilateral = rotation</span><span class="chip" style="--i:3">Bilateral = flexion/extension</span></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Jumped Facets: Treatment</h2><p class="small">The bony injury needs to be reduced</p><ul class="pts"><li><b>Unilateral:</b> may be reduced in <b>traction</b>, then <b>halo</b> or surgical fusion</li><li><b>Bilateral:</b> closed traction is <b>controversial</b></li><li>Generally need <b>surgery</b> (anterior or posterior approach) with <b>intraoperative reduction</b></li><li>Some surgeons prefer an <b>MRI before reduction</b> to look for disc herniations</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Additional Principles (1)</h2><p class="small">10.12.11 · Additional principles for cervical trauma</p><ul class="pts"><li>Unless <b>AOD</b> is present (transverse ligament torn in its midportion), most <b>isolated ligamentous injuries</b> can be managed with a <b>cervical collar</b> alone</li><li>Follow up in <b>4 to 6 weeks</b>: evaluate range of motion and cervical tenderness</li><li><b>Plain radiographs</b> do not show the <b>C7–T1</b> disc space and facets well</li><li>If concerned about a junctional injury: <b>CT and/or MRI</b> is necessary</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Additional Principles (2)</h2><p class="small">Predisposing conditions and prior hardware</p><ul class="pts"><li><b>Rheumatoid arthritis, Down syndrome, ankylosing spondylitis</b>, and other conditions predisposing to cervical instability: <b>careful imaging and examination</b> after trauma</li><li><b>Hardware from previous cervical surgery</b>: needs careful evaluation</li><li>X-rays, CT, and <b>CT myelograms</b> are useful</li><li><b>MRI</b> is necessary to evaluate the cord, but evaluation of the bones may be limited by <b>artifact</b></li></ul></div></article></div></section><section class="sec" id="sec-tl" style="--k:var(--org)"><header><h2>Thoracic and thoracolumbar trauma</h2><span class="cnt">13 cards · 18 flashcards</span></header><div class="hooks"><div class="hook"><b>Denis columns:</b> Anterior · Middle · Posterior. Compression: <b>A fails, M hinge</b>. Seatbelt: <b>M + P fail, A hinge</b>. Fracture-dislocation: <b>all 3 fail</b>.</div><div class="hook"><b>TLICS:</b> Morphology <b>1-2-3-4</b> · PLC <b>0-2-3</b> · Neuro <b>0-2-2-3-3</b>. Total <b>&lt;4 non-op · 4 either · &gt;4 operate</b>.</div><div class="hook">Burst <b>B</b> = superior end plate = <b>most common</b>.</div></div><div class="grid"><article class="card" style="--k:var(--red)"><div class="in"><h2>Thoracic Injuries</h2><p class="small">10.13</p><ul class="pts"><li>The spinal cord generally ends at <b>L1–L2</b>; the <b>cauda equina</b> fills the distal canal</li><li><b>Significant force</b> is needed to fracture the thoracic vertebrae</li><li>But the canal is <b>narrow</b>, so the cord is vulnerable to injury from <b>retropulsed or dislocated fragments</b></li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">L1–L2</div><div class="l">cord ends</div></div><div class="stat" style="--i:1"><div class="n">Narrow</div><div class="l">thoracic canal</div></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Thoracic: Level of Lesion</h2><p class="small">10.13 continued</p><div class="boxes"><div class="box" style="--i:0;background:var(--red)">Above the cord end<small>Complete or incomplete <b>paraplegia</b></small><small><b>Bowel/bladder</b> problems</small><small>Typical <b>upper motor neuron</b> findings</small></div><div class="box" style="--i:1;background:var(--blue)">Below the cord end<small>Involves <b>nerve roots</b></small><small>Typical <b>lower motor neuron</b> findings</small></div></div><ul class="pts"><li><b>Conus medullaris syndrome</b> can occur with <b>T12–L1</b> injury: damage to the <b>sacral nerve roots</b> → bowel and bladder problems</li><li>Some <b>lumbar nerve roots may be intact</b></li><li>The <b>three-column approach</b> to spinal stability is in the next section</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Thoracolumbar: Denis</h2><p class="small">10.14 · Denis three-column model for spinal stability</p><div class="side"><div class="art"><svg width="190" height="150" viewBox="0 0 120 90"><rect x="8" y="14" width="30" height="60" rx="6" fill="#2f6fd0" opacity=".85"/><text x="23.0" y="48" font-size="11" font-weight="800" fill="#fff" text-anchor="middle">ANT</text><rect x="42" y="14" width="30" height="60" rx="6" fill="#e08a1e" opacity=".85"/><text x="57.0" y="48" font-size="11" font-weight="800" fill="#fff" text-anchor="middle">MID</text><rect x="76" y="14" width="36" height="60" rx="6" fill="#d94f4f" opacity=".85"/><text x="94.0" y="48" font-size="11" font-weight="800" fill="#fff" text-anchor="middle">POST</text></svg></div><div class="main"><ul class="pts"><li>Denis classified injuries into <b>minor</b> and <b>major</b></li></ul></div></div><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">Minor<small>Articulating process</small><small>Transverse process</small><small>Spinous process</small><small>Pars interarticularis fractures</small></div><div class="box" style="--i:1;background:var(--red)">Major<small>Compression</small><small>Burst</small><small>Seatbelt-type</small><small>Fracture-dislocations</small></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Thoracolumbar: Stability</h2><p class="small">10.14 · Which injuries are stable?</p><div class="rc" style="--c:var(--grn);--i:0"><div class="nm">Minor injuries</div><div class="tx">Generally <b>STABLE</b><em>But evaluate the patient for <b>other injuries</b></em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">Compression and burst fractures</div><div class="tx"><b>May</b> be stable<em>Depends on the <b>integrity of the ligaments</b></em></div></div><div class="rc" style="--c:var(--red);--i:2"><div class="nm">Seatbelt-type injuries and fracture-dislocations</div><div class="tx">Generally <b>UNSTABLE</b><em></em></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>AO Spine: Thoracolumbar</h2><p class="small">T1–L5 · a comprehensive framework</p><ul class="pts"><li>Categorizes thoracolumbar spine injuries by:</li><li class=sub>the <b>morphology</b> of the fracture</li><li class=sub>integrity of the <b>PLC</b></li><li class=sub><b>neurological status</b> of the patient</li><li>Helps guide <b>treatment and prognosis</b> of thoracolumbar fractures</li><li>Three main types, by stability and severity:</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">A<small>Compression fractures</small></div><div class="box" style="--i:1;background:var(--org)">B<small>Tension band injuries</small></div><div class="box" style="--i:2;background:var(--red)">C<small>Translation / rotation injuries</small></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>TLICS Score: Treatment</h2><p class="small">Thoracolumbar Injury Classification and Severity score (Spine Trauma Group), Table 10.5</p><ul class="pts"><li>Helps guide treatment of thoracolumbar injuries</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">&lt; 4<small>Can be treated <b>nonoperatively</b></small></div><div class="box" style="--i:1;background:var(--org)">= 4<small>May be treated <b>operatively or nonoperatively</b></small></div><div class="box" style="--i:2;background:var(--red)">&gt; 4<small>Usually warrants <b>operative</b> management</small></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>TLICS: Scoring Table</h2><p class="small">Table 10.5 · add the three parts</p><div class="grp" style="--c:var(--blue);--i:0"><div class="gn">Morphology</div><div class="gi"><span class="it">Compression<b>1</b></span><span class="it">Burst<b>2</b></span><span class="it">Translation / rotation<b>3</b></span><span class="it">Distraction<b>4</b></span></div></div><div class="grp" style="--c:var(--red);--i:1"><div class="gn">Posterior ligamentous complex</div><div class="gi"><span class="it">Intact<b>0</b></span><span class="it">Suspected / indeterminate<b>2</b></span><span class="it">Injured<b>3</b></span></div></div><div class="grp" style="--c:var(--grn);--i:2"><div class="gn">Neurologic involvement</div><div class="gi"><span class="it">Intact<b>0</b></span><span class="it">Nerve root involvement<b>2</b></span><span class="it">Cord / conus: complete<b>2</b></span><span class="it">Cord / conus: incomplete<b>3</b></span><span class="it">Cauda equina syndrome<b>3</b></span></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Compression Fractures</h2><p class="small">10.15 · which column fails?</p><div class="boxes"><div class="box" style="--i:0;background:var(--red)">Anterior column<small>FAILS</small></div><div class="box" style="--i:1;background:var(--grn)">Middle column<small>INTACT: serves as a hinge</small></div><div class="box" style="--i:2;background:var(--org)">Posterior column<small>MAY fail, depending on the forces involved</small></div></div><ul class="pts"><li>Injuries involving <b>more than one column</b> may be <b>unstable</b></li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Burst Fractures</h2><p class="small">10.15.1 · Denis: five categories (Table 10.6)</p><ul class="pts"><li>Purely <b>bony</b> injuries can be managed <b>conservatively</b> in select cases</li><li>Patients who <b>cannot or will not tolerate a brace</b> fare better with <b>surgery</b></li><li><b>Two-level</b> injuries: the bone or disc of the <b>middle column</b> is injured</li><li>These patients <b>may require surgery</b></li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Burst Types A, B, C</h2><p class="small">Denis classification, Table 10.6</p><div class="rc" style="--c:var(--grn);--i:0"><div class="nm">Type A</div><div class="tx">Both end plates fractured, <b>no kyphosis</b>. Bone may be retropulsed into the canal.<em>Cause: <b>pure axial load</b>; usually <b>lumbar</b> spine</em></div></div><div class="rc" style="--c:var(--red);--i:1"><div class="nm">Type B</div><div class="tx"><b>Superior end plate</b> fracture. <b>Most common.</b><em>Cause: axial load + flexion; usually <b>thoracolumbar junction</b></em></div></div><div class="rc" style="--c:var(--org);--i:2"><div class="nm">Type C</div><div class="tx"><b>Inferior end plate</b> fracture<em>Cause: axial load + flexion; no particular sites commonly involved</em></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Burst Types D, E</h2><p class="small">Denis classification, Table 10.6</p><div class="rc" style="--c:var(--blue);--i:0"><div class="nm">Type D</div><div class="tx"><b>Burst rotation</b> fracture: comminution of the vertebral body, possible laminar fractures, bone retropulsed into the canal<em>Cause: <b>axial load + rotation</b>; <b>midlumbar</b> spine</em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">Type E</div><div class="tx"><b>Burst lateral flexion</b>: fractured posterior wall of the vertebral body, extrusion towards the side of the flexion<em>Cause: <b>axial load + lateral flexion</b></em></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Seatbelt-Type Injuries</h2><p class="small">10.15.2</p><ul class="pts"><li><b>Middle and posterior columns fail</b> when the patient is severely flexed</li><li>Usually <b>restrained occupants</b> in a motor vehicle accident</li><li>The anterior column acts like a <b>hinge</b> and may be injured as well</li><li>The spine is <b>unstable in flexion</b></li><li>One-level injuries may present as a <b>Chance fracture</b>: a fracture through the <b>vertebral body and neural arch</b>, with disruption of the <b>disc and PLL</b></li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Fracture Dislocations</h2><p class="small">10.15.3</p><ul class="pts"><li><b>All three columns fail</b></li><li>The mechanism of injury can vary:</li><li class=sub>compression, tension, rotation, or shear</li><li>Most of these injuries <b>require surgery</b></li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--red)">3 columns<small>all fail</small></div></div></div></article></div></section><section class="sec" id="sec-sac" style="--k:var(--grn)"><header><h2>Sacral fractures and trauma pearls</h2><span class="cnt">4 cards · 5 flashcards</span></header><div class="hooks"><div class="hook">Denis zones go <b>lateral → through foramina → medial</b> = risk <b>low → moderate → high</b>.</div><div class="hook">Roy-Camille zone 3: <b>1 kyphosis · 2 retrolisthesis · 3 anterolisthesis · 4 comminution</b>.</div></div><div class="grid"><article class="card" style="--k:var(--grn)"><div class="in"><h2>Sacral Fractures</h2><p class="small">10.16</p><ul class="pts"><li><b>Less common</b>; often caused by <b>shear forces</b></li><li>Can injure <b>sacral roots and plexus</b> and affect <b>pelvic and spinopelvic stability</b></li><li>Injuries <b>below S2</b> should not affect ambulation but may be <b>unstable</b> and cause pain that <b>improves after surgical fixation</b></li><li>More <b>medial</b> fractures: higher rate of neurologic injury and <b>worse outcomes</b></li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Denis Sacral Zones</h2><p class="small">Categorizes by location and risk of neurological injury (Fig. 10.14); guides treatment</p><figure class="fig"><img alt="Fig. 10.14 · Denis zones I, II, III of the sacrum." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 10.14 · Denis zones I, II, III of the sacrum.</figcaption></figure><div class="side"><div class="art"><svg width="190" height="160" viewBox="0 0 120 100"><polygon points="10,8 110,8 80,95 40,95" fill="#e9e4d8" stroke="#8c8472" stroke-width="2.5"/><path d="M36 10L48 92M52 10L56 92" stroke="#d94f4f" stroke-width="2.5" stroke-dasharray="5 3"/><circle cx="44.0" cy="30" r="4" fill="#8c8472"/><circle cx="45.0" cy="50" r="4" fill="#8c8472"/><circle cx="46.0" cy="70" r="4" fill="#8c8472"/><text x="22" y="22" font-size="11" font-weight="800" fill="#d94f4f" text-anchor="middle">I</text><text x="45" y="22" font-size="11" font-weight="800" fill="#d94f4f" text-anchor="middle">II</text><text x="70" y="22" font-size="11" font-weight="800" fill="#d94f4f" text-anchor="middle">III</text></svg></div><div class="main"><div></div></div></div><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">Zone I<small><b>Lateral</b> to foramina</small><small><b>Low</b> risk of nerve damage</small><small>Typically treated <b>conservatively</b></small></div><div class="box" style="--i:1;background:var(--org)">Zone II<small><b>Through</b> the foramina</small><small><b>Moderate</b> risk</small><small>May require <b>surgery</b> based on displacement</small></div><div class="box" style="--i:2;background:var(--red)">Zone III<small><b>Medial</b> to foramina</small><small><b>High</b> risk of severe neurological damage</small><small>Often requires <b>surgical intervention</b></small></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Zone 3 Sacral Fractures</h2><p class="small">Roy-Camille schematic, later modified by Strange-Vognsen and Lebech (Fig. 10.15): further classification of Denis type 3</p><figure class="fig"><img alt="Fig. 10.15 · Types 1–4 of Denis zone 3 fractures: kyphosis without translation, retrolisthesis, anterolisthesis, upper sacral comminution." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 10.15 · Types 1–4 of Denis zone 3 fractures: kyphosis without translation, retrolisthesis, anterolisthesis, upper sacral comminution.</figcaption></figure><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">Type 1<small>Kyphosis without translation</small></div><div class="box" style="--i:1;background:var(--blue)">Type 2<small>Retrolisthesis</small></div><div class="box" style="--i:2;background:var(--org)">Type 3<small>Anterolisthesis</small></div><div class="box" style="--i:3;background:var(--red)">Type 4<small>Upper sacral comminution</small></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Pearls: Spinal Trauma</h2><ul class="pts"><li>Remember the <b>ABCs</b> of resuscitation. Look for <b>life-threatening injuries</b> in patients with significant spine injuries. Patients in <b>spinal and/or hemorrhagic shock</b> need aggressive treatment and careful monitoring. <b>Avoid hypotension</b> in spinal cord injury.</li><li>Do a <b>thorough neurological exam</b> on any patient with suspected spine trauma: it guides the decision to image the spine.</li><li>Take extra caution with <b>spinal hardware</b> or conditions predisposing to <b>cord compression</b> and serious neurological injury.</li><li>Many conditions make people susceptible to major spine injury from a <b>seemingly trivial injury</b>: if the injury seems <b>out of proportion to the mechanism</b>, obtain imaging promptly.</li></ul></div></article></div></section><section class="sec" id="sec-deg" style="--k:var(--blue)"><header><h2>Cervical degenerative disease</h2><span class="cnt">23 cards · 20 flashcards</span></header><div class="hooks"><div class="hook"><b>Radiculopathy = root</b> (neuroforamen). <b>Myelopathy = cord.</b> Protrusion deforms the annulus; extrusion ruptures through it.</div><div class="hook">Disc levels: <b>C5–C6 &gt; C4–C5 &gt; C6–C7</b>.</div><div class="hook"><b>No arthroplasty</b> when there is appreciable facet disease. <b>ACDF</b> is the commonest operation (85–95% success at 10 years).</div></div><div class="grid"><article class="card" style="--k:var(--blue)"><div class="in"><h2>Chapter 11: Spine</h2><p class="small">11.1 Introduction</p><ul class="pts"><li><b>Nontraumatic</b> spine diseases affect millions of people worldwide</li><li><b>Degenerative</b> diseases of the cervical, thoracic, and lumbar spines: pain, functional deficiencies, and/or <b>neurological symptoms</b></li><li>Other pathologies: <b>vascular, neoplastic, and/or infectious</b> lesions that can compress neural elements → symptoms of <b>cord or nerve root compression</b></li><li>The chapter covers pathophysiology, clinical and radiographic presentation, treatment options, and clinical outcomes</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Cervical Degenerative Disease</h2><p class="small">11.2</p><ul class="pts"><li>Very <b>prevalent</b>: affects nearly <b>two-thirds</b> of the population at some time in their lifetime</li><li>Leads to <b>neck pain</b> and <b>neurologic deficits</b> in a subset of patients</li><li>Most follow a <b>benign course</b> with minimal or no symptoms</li><li>Can also compress neural elements → <b>myelopathy or radiculopathy</b> plus local mechanical neck pain</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">≈ 2/3</div><div class="l">of the population</div></div><div class="stat" style="--i:1"><div class="n">21.7%</div><div class="l">baseline prevalence of radiographic cervical disc degeneration</div></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Degenerative Cervical Myelopathy</h2><p class="small">11.3 · DCM</p><ul class="pts"><li>Nontraumatic degenerative cervical myelopathy is the <b>most common cause of spinal cord pathology</b> among the <b>elderly</b></li><li>Subdivided into <b>osteoarthritic (spondylotic)</b> and <b>nonosteoarthritic</b> changes</li><li>Both types can ultimately cause <b>symptomatic spinal cord compression</b> or myelopathy</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">605</div><div class="l">per million individuals in North America</div></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Degenerative Disc Disease (1)</h2><p class="small">11.3.1 Cervical osteoarthritis</p><ul class="pts"><li>The intervertebral disc is an <b>avascular fibrocartilaginous</b> structure</li><li><b>Outer annulus fibrosus</b> + <b>inner nucleus pulposus</b>: both contain poorly vascularized cells</li><li>Annulus: <b>fibrocyte-like</b> cells. Nucleus: <b>chondrocyte-like</b> cells</li><li><b>Proteoglycans and collagen fibers</b> form the extracellular matrix the cells sit in</li><li>The structure lets the disc <b>redistribute compressive forces radially</b> instead of passing them longitudinally</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Degenerative Disc Disease (2)</h2><p class="small">Why the disc degenerates</p><ul class="pts"><li>Disc degeneration can occur with <b>excessive or repetitive use, trauma</b>, and/or <b>genetic or environmental</b> factors</li><li>Guiot et al: <b>compromised diffusion</b> of substances (including <b>oxygen and nutrients</b>) through the disc is a central mechanism of <b>cell death and disc degeneration</b></li><li>This can lead to:</li></ul><div class="chips"><span class="chip" style="--i:0">Force redistribution in the column</span><span class="chip" style="--i:1">More stress on the annulus</span><span class="chip" style="--i:2">Lower disc height</span><span class="chip" style="--i:3">Protrusion / herniation</span><span class="chip" style="--i:4">Osteophytes</span></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Cervical Disc Herniation: Pathology</h2><p class="small">Nucleus pulposus vs. annulus fibrosus</p><div class="boxes"><div class="box" style="--i:0;background:var(--org)">Protrusion<small>Nucleus <b>deforms</b> the annulus but does <b>not rupture</b> through it</small></div><div class="box" style="--i:1;background:var(--red)">Extrusion<small>Nucleus <b>ruptures through</b> the annulus fibrosus</small></div></div><ul class="pts"><li><b>Radiculopathy:</b> nerve impingement at the level of the <b>neuroforamen</b></li><li><b>Myelopathy:</b> <b>spinal cord compression</b></li></ul><div class="key">Disc herniations can be <b>“soft” or “hard”</b>: hard = involving <b>osteophytes</b> (calcified bone spurs). <b>CT</b> may help when a calcified disc is suspected.</div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Disc–Osteophyte Complex</h2><p class="small">Cervical disc herniation: level</p><ul class="pts"><li>Herniations with osteophytes are commonly called <b>disc–osteophyte complexes</b></li><li>Most commonly affected intervertebral disc level, in order:</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--red)">C5–C6<small>most common</small></div><div class="box" style="--i:1;background:var(--org)">C4–C5<small>second</small></div><div class="box" style="--i:2;background:var(--blue)">C6–C7<small>third</small></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Cervical Disc: Diagnosis (1)</h2><p class="small">Plain radiographs and MR</p><div class="rc" style="--c:var(--blue);--i:0"><div class="nm">Plain radiographs</div><div class="tx">Useful when suspicion is high for <b>spondylolisthesis</b> or cervical <b>fractures and dislocations</b><em>Dynamic <b>flexion/extension</b> films assess stability: information advanced imaging in a motionless patient cannot give</em></div></div><div class="rc" style="--c:var(--grn);--i:1"><div class="nm">MR</div><div class="tx"><b>Single most useful test</b>. Anatomical information in degenerative disease<em>Valuable for <b>inflammatory, infectious, or neoplastic</b> conditions. Modality of choice to see <b>neural elements</b> and <b>intrinsic cord disease</b></em></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Cervical Disc: Diagnosis (2)</h2><p class="small">MR key findings and CT myelography</p><ul class="pts"><li><b>Key MR findings:</b></li></ul><div class="chips"><span class="chip" style="--i:0">Loss of nucleus pulposus signal on T2</span><span class="chip" style="--i:1">Disc migration into canal, compressing thecal sac or nerve roots</span><span class="chip" style="--i:2">Narrowing of the disc space</span></div><ul class="pts"><li><b>CT myelography:</b> useful for associated <b>spondylosis and ligamentous degeneration</b> (calcification and/or ossification)</li><li>When <b>MRI cannot be done</b> (implanted devices that are not MR-compatible), CT myelography may be the <b>best option</b> to show intraspinal structures</li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Cervical Disc: Symptoms</h2><p class="small">Radiculopathy</p><ul class="pts"><li>Neck pain, arm pain, numbness, tingling, and <b>weakness in the upper extremities</b></li><li>Arm pain from root compression follows a <b>dermatomal distribution</b></li><li><b>Position-dependent relief</b> is possible: pain relieved by <b>holding the arm up</b> on the same side as the compressed root, and by <b>leaning the head away</b> from that side</li><li>Both maneuvers may <b>increase foraminal surface area</b> and lessen radicular pain</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Cervical Myelopathy: Presentation</h2><p class="small">Symptoms (subjective) and signs (objective)</p><ul class="pts"><li>Cervical myelopathy can present with:</li></ul><div class="chips"><span class="chip" style="--i:0">Ataxia</span><span class="chip" style="--i:1">Gait disturbance</span><span class="chip" style="--i:2">Bowel and bladder dysfunction</span><span class="chip" style="--i:3">Difficulty with fine motor movements</span><span class="chip" style="--i:4">Uncoordinated lower and upper extremity movements</span></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Cervical Myelopathy: Exam</h2><p class="small">A thorough history and detailed exam in all patients</p><ul class="pts"><li>Detailed <b>musculoskeletal and neurological</b> exam: <b>gait</b>, <b>range of motion</b> of the cervical spine, <b>sensation in the dermatomes</b> of upper and lower extremities, <b>motor strength</b>, <b>deep tendon reflexes</b>, and the <b>cranial nerves</b></li><li>Rule out <b>entrapment syndromes</b> (such as carpal tunnel) and <b>motor neuron diseases</b></li><li>Findings that support cervical myelopathy:</li></ul><div class="chips"><span class="chip" style="--i:0">Positive Babinski</span><span class="chip" style="--i:1">Positive Hoffmann’s</span><span class="chip" style="--i:2">Ankle clonus</span><span class="chip" style="--i:3">Hyperreflexia</span><span class="chip" style="--i:4">Increased tone in the legs</span></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Cervical Disc: Nonoperative</h2><p class="small">Treatment</p><ul class="pts"><li>Treatment can be <b>nonoperative or operative</b></li><li>Cervical radiculopathy: try nonoperative treatment for <b>up to 6 weeks</b>:</li></ul><div class="chips"><span class="chip" style="--i:0">Anti-inflammatory medications</span><span class="chip" style="--i:1">Transforaminal epidural corticosteroid injections</span><span class="chip" style="--i:2">Physical therapy</span><span class="chip" style="--i:3">Cervical traction</span></div><ul class="pts"><li><b>Surgery</b> usually indicated for <b>persistent radiculopathy</b>, <b>progressive symptoms, worsening neurological status</b>, or <b>myelopathy</b></li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Cervical Disc: Surgery</h2><p class="small">Anterior approach</p><ul class="pts"><li>Both <b>anterior and posterior</b> approaches have been used to remove the herniated disc and decompress the root at the foramen</li><li>For herniated cervical discs, <b>ACDF</b> is the <b>most commonly performed</b> operation</li><li>A recent <b>10-year</b> prospective study: self-reported <b>success 85% to 95%</b></li><li><b>Arthroplasty</b> (anterior approach) replaces the native disc with an <b>artificial disc</b>: several trials show excellent long-term performance</li><li>Needs <b>no significant posterior element degenerative disease</b>; <b>younger</b> patients are more optimal candidates</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Cervical Disc: Posterior Surgery</h2><ul class="pts"><li><b>Posterior decompression</b> has a long track record of success; may or may not be done with a <b>fusion</b></li><li>Considerations for a posterior approach: perceived <b>approach-related morbidity</b> from muscular dissection, and <b>limited access</b> in central cervical disc herniations</li><li>The <b>CSM-S trial</b> randomized patients to <b>ventral or dorsal</b> surgery for cervical spondylotic myelopathy; it will clarify the effect of approach on outcomes</li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Anterior Surgery: Complications</h2><ul class="pts"><li><b>Dysphagia</b></li><li><b>Recurrent laryngeal nerve palsy</b> → voice hoarseness</li><li><b>Superior laryngeal nerve palsy</b> → weak voice</li><li><b>CSF leaks</b> and <b>vascular injury</b></li><li><b>Postoperative hematomas</b>: can compromise the <b>airway</b> if not identified and decompressed in time</li><li><b>Adjacent segment disease:</b> degeneration of the disc next to an operated level, presumably from <b>increased load</b> on the neighboring vertebra</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Osteophytosis: Pathology</h2><p class="small">Cervical bone spurs</p><ul class="pts"><li>After disc degeneration, <b>mechanical stress on the end plates</b> increases and <b>osteophytes</b> form along the <b>ventral spinal canal</b> → compression of cord and/or roots</li><li>A <b>reactive response to segment hypermobility</b>: short-term it increases stability by increasing end plate surface area</li><li><b>Uncinate process hypertrophy</b> (subaxial) → <b>foraminal stenosis</b> → radiculopathy</li><li>Typically occurs in patients with <b>pre-existing cervical degeneration</b></li></ul></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Osteophytosis: Dx and Treatment</h2><ul class="pts"><li><b>CT</b> is important: higher sensitivity than MRI or plain films for <b>bony structures</b></li><li>Best foraminal evaluation in disc–osteophyte complexes: <b>myelogram + postmyelogram CT</b></li><li><b>Surgery</b> for <b>progressive myelopathy</b> with radiographic <b>cord compression or canal stenosis</b></li><li><b>Early decompression and osteophyte resection</b>, anterior or posterior</li><li>Risk of <b>spinal cord injury</b> from either approach: assess before surgery</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Facet Joint Degeneration (1)</h2><p class="small">Pathology</p><ul class="pts"><li><b>Osteoarthritis</b> of the facet (zygapophyseal) joints is common in <b>older adults</b></li><li>Changes: <b>pitting</b> and erosion of articular cartilage, <b>capsule fibrosis</b>, <b>subchondral bone remodeling</b>, osteophytes</li><li>Cervical <b>DDD</b> → decreased load-bearing by the disc → <b>more force across the facets</b> → facet <b>hypertrophy and instability</b></li><li>Facet arthropathy is often found at levels <b>with DDD</b></li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Facet Joint Degeneration (2)</h2><ul class="pts"><li>Facet hypertrophy can also come with <b>age-related loss of paraspinal muscle mass</b>, which further <b>destabilizes the column</b></li><li><b>Spondylolisthesis</b> and <b>degenerative scoliosis</b> are both linked to facet OA</li><li>In spondylolisthesis, <b>cartilage degradation and osteophyte formation</b> are believed to be the main mechanisms of <b>facet subluxation</b>, displacing the adjacent vertebra</li></ul></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Facet Joint: Diagnosis</h2><ul class="pts"><li>Signs: <b>hypertrophy of articular processes</b>, <b>joint narrowing</b>, <b>osteophytes</b>, <b>subchondral cysts</b></li><li><b>CT</b> for bony pathology; <b>MRI</b> for neural elements</li><li>Radiographic facet OA does <b>not always correlate with neck pain</b> (diagnostic criteria vary)</li><li>Most common at <b>C3–C5</b>; one study: <b>57%</b> of adults <b>≥ 65 years</b></li><li><b>1 to 2 mm</b> of subluxation may be well tolerated and cause no symptoms</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">57%</div><div class="l">cervical facet OA, age ≥ 65</div></div><div class="stat" style="--i:1"><div class="n">1–2 mm</div><div class="l">subluxation may be tolerated</div></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Facet Joint: Clinical Picture</h2><ul class="pts"><li>Localized <b>neck pain</b>, with or without radiation to the upper limbs</li><li><b>Midcervical and lower</b> cervical: pain in the <b>posterior scapular region</b>, radiating to the <b>shoulder girdle</b></li><li><b>Upper cervical:</b> pain in the <b>occipital region</b> and/or <b>headaches</b></li><li>Rule out <b>herniated discs, fracture-dislocations, neoplasms, spinal stenosis</b> as other causes</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Facet Joint: Treatment</h2><ul class="pts"><li>Carefully evaluate <b>facet joint morphology</b> when considering surgery</li><li>Patients with <b>no symptoms</b> may need <b>no treatment</b>, but may warrant <b>long-term follow-up</b></li><li>If significant facet degeneration has occurred, <b>disc arthroplasty is contraindicated</b></li><li>This was an <b>exclusion criterion</b> in the original arthroplasty trials: avoid arthroplasty when <b>appreciable facet disease</b> is present</li></ul></div></article></div></section><section class="sec" id="sec-opll" style="--k:var(--red)"><header><h2>OPLL (ossified PLL)</h2><span class="cnt">8 cards · 6 flashcards</span></header><div class="hooks"><div class="hook"><b>S-C-M-L</b> = Segmental, Continuous, Mixed, Localized.</div><div class="hook"><b>CT</b> to diagnose, <b>MRI</b> for the cord. Natural history: <b>17% · 18 years · &gt;60% stenosis</b>.</div><div class="hook"><b>Anterior surgery = CSF-leak risk</b> (calcified PLL glued to dura); many surgeons go posterior.</div></div><div class="grid"><article class="card" style="--k:var(--org)"><div class="in"><h2>Ligamentous Degeneration (OPLL)</h2><p class="small">Pathology · the posterior longitudinal ligament lies dorsal to the vertebral body and ventral to the cord</p><ul class="pts"><li>DCM can result from <b>age-related PLL changes</b>: <b>hypertrophy, calcification, and/or ossification</b></li><li><b>Hypertrophy</b> is believed to <b>precede ossification</b>; likely genetic, biomechanical, environmental, and systemic influences</li><li><b>OPLL</b> most commonly in the <b>cervical spine</b>; higher in <b>men, the elderly, and the Asian subpopulation</b></li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>OPLL: Pathogenesis and Types</h2><ul class="pts"><li>Not well understood; initial PLL hypertrophy may be <b>secondary to prolapse of the nucleus pulposus</b></li><li><b>Four primary types:</b></li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--blue)">Segmental</div><div class="box" style="--i:1;background:var(--grn)">Continuous</div><div class="box" style="--i:2;background:var(--org)">Mixed</div><div class="box" style="--i:3;background:var(--red)">Localized</div></div><ul class="pts"><li>Specifics are beyond the chapter; all play a significant role in <b>surgery vs. nonoperative</b> decisions</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>OPLL: Diagnosis</h2><p class="small">Fig. 11.1: (a) sagittal CT, segmental OPLL; (b) axial CT</p><figure class="fig"><img alt="Fig. 11.1 · (a) Sagittal CT: segmental OPLL. (b) Axial CT: OPLL." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 11.1 · (a) Sagittal CT: segmental OPLL. (b) Axial CT: OPLL.</figcaption></figure><ul class="pts"><li><b>CT</b> has better intrarater reliability than traditional radiography</li><li><b>MRI</b> is better than CT for <b>cord compression</b> (myelopathy) or <b>foraminal stenosis</b> (radiculopathy)</li><li>But MRI is <b>not reliable for diagnosing a calcified PLL</b></li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>OPLL: Symptoms</h2><ul class="pts"><li><b>Rare</b> in early stages; advanced disease may bring <b>serious neurological symptoms</b></li><li>Early: <b>pain, numbness or tingling in the hands, dysesthesia</b></li><li>Myelopathic: <b>gait disturbance</b>, changes in <b>fine motor skills or balance</b></li><li>Progression is <b>slow in most (80%)</b>, depends on age at presentation</li><li>Presentation in the <b>fourth decade or earlier</b> is more often <b>progressively symptomatic</b></li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">80%</div><div class="l">slow progression</div></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>OPLL: Natural History</h2><ul class="pts"><li>Prospective study in patients <b>without initial myelopathy</b>:</li><li>Of note, <b>more than 60% canal stenosis</b> was an important predictive risk factor for myelopathy</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">17%</div><div class="l">developed myelopathy</div></div><div class="stat" style="--i:1"><div class="n">18 yr</div><div class="l">follow-up</div></div><div class="stat" style="--i:2"><div class="n">&gt; 60%</div><div class="l">canal stenosis = risk factor</div></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>OPLL: Treatment</h2><ul class="pts"><li><b>Conservative:</b> oral analgesics and physical therapy</li><li><b>Operative</b> for progressive myelopathy and/or radiculopathy, or failed nonoperative care: <b>anterior, posterior, or combined AP</b></li><li>Anterior surgery in OPLL has <b>excessive bleeding</b> and <b>dural injury</b> risk (CSF leak, cord injury), so many surgeons use <b>posterior</b> surgery: standard <b>laminectomy with fusion</b> or <b>laminoplasty</b></li><li><b>Combined AP</b> approaches: often for significant <b>kyphotic deformity</b> on preoperative imaging</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>OPLL: Anterior Approaches</h2><div class="rc" style="--c:var(--grn);--i:0"><div class="nm">ACDF (single or multiple)</div><div class="tx">Often a <b>thin layer of ossified ligament is left</b>, adherent to the dura (“floating”)<em>Decompresses the cord while <b>minimizing dural tear</b> risk</em></div></div><div class="rc" style="--c:var(--red);--i:1"><div class="nm">Corpectomy and fusion</div><div class="tx">Can be complicated by <b>dural tears and CSF leaks</b><em>Calcified PLL <b>adheres to the dura</b> (no plane of dissection). Removing it often <b>resects the ventral dura</b> too → CSF leak</em></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>OPLL: Posterior Approaches</h2><div class="rc" style="--c:var(--grn);--i:0"><div class="nm">Laminoplasty</div><div class="tx">Can be complicated by postoperative <b>axial neck pain</b><em></em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">Laminotomy</div><div class="tx">Can be complicated by postoperative <b>kyphosis</b><em></em></div></div><div class="rc" style="--c:var(--blue);--i:2"><div class="nm">Laminectomy and fusion</div><div class="tx">Posterior option<em></em></div></div><div class="stats"><div class="stat" style="--i:0"><div class="n">21.8%</div><div class="l">overall complication rate in OPLL: more common than other cervical pathology</div></div></div></div></article></div></section><section class="sec" id="sec-thl" style="--k:var(--grn)"><header><h2>Thoracic and lumbar degenerative disease</h2><span class="cnt">10 cards · 7 flashcards</span></header><div class="hooks"><div class="hook">Thoracic DDD is rare (<b>ribs splint</b>); herniation most common <b>T8–T12</b>; <b>T3–T6 = watershed</b> for the cord.</div><div class="hook"><b>Transthoracic 93% recovery</b> but <b>more pulmonary complications</b>. LBP: <b>11.9% · 80% · 150 M days</b>.</div></div><div class="grid"><article class="card" style="--k:var(--grn)"><div class="in"><h2>Thoracic Degenerative Disease (1)</h2><p class="small">11.4 · T1–T12</p><ul class="pts"><li>Each thoracic vertebra <b>articulates with the rib head facets</b>, which <b>limits mobility</b></li><li>Thoracic <b>discs are thinner</b> and the <b>canal diameter is reduced</b> vs. cervical and lumbar</li><li>Symptomatic DDD is seen <b>much less often</b>, possibly because the <b>ribs splint</b> the spine</li><li>Herniated thoracic disc operations: only <b>0.14% to 4%</b> of all spinal disc excisions</li><li>Classified by location: <b>central, lateral, or centrolateral</b></li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">0.14–4%</div><div class="l">of disc excision operations</div></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Thoracic Degenerative Disease (2)</h2><p class="small">Imaging</p><ul class="pts"><li>As in the cervical spine, imaging findings do <b>not necessarily correlate with symptoms</b></li><li>One study: <b>37%</b> of older adults (no thoracic/lumbar pain history, or low back pain only) had thoracic disc herniation on MRI</li><li>Wider use of <b>MRI</b> has increased detection of herniations that may or may not be symptomatic (lower with plain films and/or CT)</li><li>More common in the <b>lower thoracic spine (T8–T12)</b>: more flexion/extension movement and less resistance to rotation</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">37%</div><div class="l">older adults with herniation on MRI</div></div><div class="stat" style="--i:1"><div class="n">T8–T12</div><div class="l">most common</div></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Thoracic Cord Vulnerability</h2><ul class="pts"><li>Compression of the cord and nerve roots → <b>myelopathy</b> and <b>radiculopathy</b></li><li>The thoracic spine’s <b>natural kyphosis</b> and the <b>dentate ligaments</b> in the posterior canal raise the risk of <b>ventral cord compression</b> from protruding discs</li><li>Limited <b>vascular anastomoses</b> in the thoracic cord, especially <b>T3–T6</b> (a <b>watershed region</b>) → <b>ischemia</b> of the neural elements and myelopathy</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--red)">T3–T6<small>watershed region</small></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Thoracic Disc: Clinical Picture</h2><ul class="pts"><li>Severity varies with <b>extent of herniation</b>, <b>location within the canal</b>, and comorbidities</li><li><b>Pain</b> is common: <b>middle or lower back</b> pain radiating to the <b>abdomen, groin, lower limbs</b>, and/or the <b>anterior chest</b></li><li>Differential for upper/middle back pain: <b>cardiovascular, pulmonary, neoplastic, hepatobiliary, gastrointestinal</b></li><li><b>Nonoperative</b> treatment for patients without significant <b>neurological deterioration, pain, and/or myelopathic symptoms</b></li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Thoracic Disc: Surgery (1)</h2><p class="small">Fig. 11.2: (a) transpedicular, (b) anterolateral (thoracotomy and thoracoscopy), (c) costotransversectomy</p><figure class="fig"><img alt="Fig. 11.2 · (a) Transpedicular, (b) anterolateral (thoracotomy/thoracoscopy), (c) costotransversectomy." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 11.2 · (a) Transpedicular, (b) anterolateral (thoracotomy/thoracoscopy), (c) costotransversectomy.</figcaption></figure><ul class="pts"><li>Open and endoscopic options for <b>progressive symptoms</b></li><li>Approaches: <b>transthoracic-transpleural (thoracotomy)</b>, <b>posterolateral</b> (transpedicular or costotransversectomy), or <b>lateral</b></li><li>Only <b>thoracotomy and thoracoscopic</b> approaches show the <b>ventral dura</b>; every approach has a <b>blind area</b> on the dura opposite the surgeon’s line of view</li><li><b>Decompressive laminectomy</b> was abandoned (morbidity and mortality <b>up to 50%</b>): outcomes have improved</li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Thoracic Disc: Surgery (2)</h2><p class="small">Outcomes by approach</p><ul class="pts"><li><b>Mulier and Debois:</b> higher partial or total <b>neurological recovery</b> with the <b>transthoracic</b> approach vs. posterolateral or lateral (p &lt; 0.05)</li><li>But transthoracic also had more <b>pulmonary complications</b> (p &lt; 0.025)</li><li><b>Anterior approach morbidity</b> (prolonged postoperative pain) has made <b>posterior approaches</b> more popular recently</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">93%</div><div class="l">recovery, transthoracic</div></div><div class="stat" style="--i:1"><div class="n">up to 50%</div><div class="l">morbidity/mortality of laminectomy</div></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Thoracic Disc: Surgery (3)</h2><p class="small">Minimally invasive thoracoscopy and choice of approach</p><ul class="pts"><li><b>Thoracoscopic</b> surgery for <b>single or bilevel</b> lesions: <b>shorter stay, fewer complications, less morbidity</b> than open</li><li>Still <b>not widely accepted</b>: <b>learning curve</b>, many cases of <b>inadequate disc excision</b></li><li>Choice depends on <b>overall health, disc size, location relative to the canal, consistency (soft vs. calcified)</b>, spinal biomechanics, and the surgeon’s <b>comfort</b> with the options</li></ul></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Lumbar Back Pain</h2><p class="small">11.5 · LBP</p><ul class="pts"><li>A frequent clinical entity with a major <b>socioeconomic burden</b></li><li><b>Acute</b> (&lt; 12 weeks) or <b>chronic</b>; most acute cases <b>resolve without surgery</b></li><li><b>Second most common cause of disability</b> among US adults</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">11.9%</div><div class="l">global point prevalence</div></div><div class="stat" style="--i:1"><div class="n">80%</div><div class="l">experience an episode in their lifetime</div></div><div class="stat" style="--i:2"><div class="n">≈ 150 M</div><div class="l">work days lost per year</div></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>LBP: Differential</h2><ul class="pts"><li>Most cases get <b>no specific diagnosis</b>; improvement without medical treatment is often rapid, <b>within 1 month</b></li><li>Differential includes (not limited to):</li><li class=sub><b>musculoskeletal pain</b> (most common)</li><li class=sub><b>degenerative lumbar disease</b> with root compression/radiculopathy or cord compression</li><li class=sub><b>fracture-dislocations, neoplasms, infections</b> (osteomyelitis): discernible from <b>history and exam</b></li><li>Compression of <b>L1–L5 roots</b> can cause <b>“sciatic”</b> symptoms plus localized LBP</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>LBP: Treatment</h2><p class="small">11.5.1 · Fig. 11.3: awake lumbar spine surgery</p><figure class="fig"><img alt="Fig. 11.3 · Patient position and spinal anesthetic for awake lumbar spine surgery." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 11.3 · Patient position and spinal anesthetic for awake lumbar spine surgery.</figcaption></figure><ul class="pts"><li>Surgical techniques range from <b>open to minimally invasive</b>; all aim to <b>decompress and stabilize</b></li><li>Guidelines: <b>Congress of Neurological Surgeons, 2014</b></li><li><b>“Awake” spinal surgery:</b> minimal sedation; <b>local anesthetics + epidural spinal injection</b></li><li>Spinal anesthetic introduced <b>two levels above</b> the operative level (e.g., L2–L3 for an L4–L5 operation)</li><li>Currently limited to <b>1–2 level fusions</b> and <b>1–3 level decompressions</b></li></ul></div></article></div></section><section class="sec" id="sec-neo" style="--k:var(--org)"><header><h2>Spinal neoplasms</h2><span class="cnt">13 cards · 10 flashcards</span></header><div class="hooks"><div class="hook"><b>Most common = metastases (extradural).</b> Primary: 69% benign → <b>29 meningioma · 24 nerve sheath · 23 ependymoma</b>.</div><div class="hook">Nerve sheath = <b>target sign</b>: Antoni <b>A</b> centre (dark), Antoni <b>B</b> rim (bright). Meningioma = <b>dural tail</b>.</div><div class="hook"><b>SINS</b> six items: Location · Pain · Bone lesion · Alignment · Collapse · Posterolateral. <b>0–6 stable · 7–12 potentially unstable · 13–18 unstable</b>.</div></div><div class="grid"><article class="card" style="--k:var(--org)"><div class="in"><h2>Spinal Neoplasms</h2><p class="small">11.6 · overall incidence ≈ 0.97 per 100,000</p><div class="side"><div class="art"><svg width="170" height="150" viewBox="0 0 120 100"><circle cx="60" cy="50" r="46" fill="#f5c27a" opacity=".5" stroke="#e08a1e" stroke-width="3"/><circle cx="60" cy="50" r="32" fill="#bcd3f3" stroke="#2f6fd0" stroke-width="3"/><circle cx="60" cy="50" r="15" fill="#f2a6b3" stroke="#b5657a" stroke-width="3"/></svg></div><div class="main"><ul class="pts"><li><b>Intradural:</b> arises inside the dura mater</li><li><b>Extradural:</b> arises outside it</li><li>Intradural → <b>intramedullary</b> (involves the cord) or <b>extramedullary</b> (does not)</li></ul></div></div><div class="key">The most common type of spinal neoplasm is <b>spinal metastases</b>, which are most commonly <b>extradural</b>.</div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Primary Spinal Tumors</h2><p class="small">Primary spinal cord tumors arise from neural elements</p><ul class="pts"><li>Predominantly <b>benign (69%)</b>; histology:</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">29%</div><div class="l">meningiomas</div></div><div class="stat" style="--i:1"><div class="n">24%</div><div class="l">nerve sheath tumors</div></div><div class="stat" style="--i:2"><div class="n">23%</div><div class="l">ependymomas</div></div></div><ul class="pts"><li>Primary <b>malignant</b> tumors: <b>64% overall 10-year survival</b></li><li>Often present with <b>back pain or deficits of the lower or upper limbs</b>, <b>sparing the head and face</b></li><li>Far less common than metastases: may be <b>misdiagnosed as degenerative disease</b></li><li>Mainstay of diagnosis: <b>MRI</b> (tumor + relation to dura and neural elements). Outcome depends on <b>location and histology</b></li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Intramedullary Tumors (1)</h2><p class="small">11.6.1 Intradural · the rarest adult spinal neoplasms</p><ul class="pts"><li>Histology: usually <b>ependymomas (30%–60%)</b> or <b>astrocytomas (30%)</b>; rare <b>hemangioblastomas (2%–8%)</b> and <b>metastases (2%)</b></li><li>More likely in the <b>longer cord segments</b>: about <b>half thoracic</b>, <b>one-third lumbar</b></li><li>Most <b>enhance on MRI</b></li></ul><div class="key"><b>Ependymomas</b> are the most common tumors of the <b>conus medullaris</b>; more common in <b>adults than children</b>; can <b>metastasize through CSF seeding</b>; associated with <b>cyst formation</b>; can be treated with <b>surgical excision</b> (they are <b>encapsulated</b>).</div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Intramedullary Tumors (2)</h2><ul class="pts"><li><b>Myxopapillary ependymomas:</b> most common variant in the <b>conus medullaris and filum terminale</b></li><li><b>Astrocytomas:</b> most common in the <b>3rd to 5th decades</b>; usually <b>low grade</b> (grade 4 in only <b>12%</b>)</li><li>The clinical picture <b>cannot distinguish</b> intramedullary tumors from other spinal neoplasms; <b>MRI</b> is the diagnostic modality of choice</li></ul></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Intramedullary Tumors (3)</h2><p class="small">Treatment</p><ul class="pts"><li><b>Asymptomatic</b> tumors can be followed <b>conservatively</b></li><li><b>Symptomatic</b> lesions: treat as soon as possible</li><li><b>Debulking</b> with microdissection, laser, or ultrasonic aspiration are all reasonable first-line options</li><li><b>Ependymomas</b> often give <b>good surgical planes</b> for dissection</li><li>Outcomes relate directly to the <b>neurological deficit before surgery</b></li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Extramedullary Tumors (1)</h2><p class="small">Intradural extramedullary · inside the dura, outside the cord</p><ul class="pts"><li>Most common: <b>nerve sheath tumors</b> (neurofibromas and schwannomas most commonly; ganglioneuromas and malignant nerve sheath tumors less commonly)</li><li><b>Malignant transformation</b> in about <b>2% to 6%</b></li><li><b>Recurrence is rare</b> in sporadic tumors if resection is complete</li></ul><div class="key">Nerve sheath tumors show a <b>“target lesion”</b> on MRI T1: <b>decreased</b> signal centrally (<b>Antoni A</b> tissue), <b>increased</b> peripherally (<b>Antoni B</b> tissue).</div><div class="stats"><div class="stat" style="--i:0"><div class="n">2–6%</div><div class="l">malignant transformation</div></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Extramedullary Tumors (2)</h2><p class="small">Meningiomas</p><ul class="pts"><li>The <b>second most common</b> intradural extramedullary tumor</li><li>Generally <b>benign, slow-growing</b></li><li>Characteristic enhancing <b>“dural tail”</b> on contrast MRI</li><li>May <b>recur in 2% to 7%</b>, depending on how completely they were resected</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">2–7%</div><div class="l">recurrence</div></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Vertebral Body Metastases</h2><p class="small">11.6.2</p><ul class="pts"><li>The most common spinal neoplasm: <b>epidural metastases</b> (most commonly from <b>lung and breast</b>); occur in <b>5% to 10%</b> of cancer patients</li><li>Present with <b>localized pain</b> (vertebral destruction/fracture) or <b>acute cord compression</b>: needs <b>urgent</b> management</li><li>Seeding: <b>vertebral column 85%</b>, <b>paravertebral tissues 14%</b>, epidural space rarely; most are in the <b>vertebral body</b>, then grow <b>posteriorly</b> to compress the cord</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">85%</div><div class="l">vertebral column</div></div><div class="stat" style="--i:1"><div class="n">14%</div><div class="l">paravertebral</div></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Metastases: Level and Symptoms</h2><ul class="pts"><li><b>Thoracic</b> most likely, then <b>lumbosacral</b>, then <b>cervical</b></li><li><b>Multiple levels</b> are common: <b>20% to 35%</b></li><li>Symptoms: <b>back pain, often worse recumbent</b>, <b>motor weakness with hyperreflexia</b>, <b>cord compression</b>, <b>cauda equina syndrome</b></li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">20–35%</div><div class="l">multiple levels</div></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Metastases: Management</h2><ul class="pts"><li>Modern management: <b>pain management, steroids, radiation therapy, and surgery</b></li><li>In symptomatic patients, <b>surgery</b> gives <b>better outcomes and quality of life</b> than radiotherapy alone</li><li><b>Spinal instability</b> and <b>neurologic function</b> are key to the decision to operate</li><li>The <b>Spinal Instability Neoplastic Score (SINS)</b> (Table 11.1) can aid referral decisions; total <b>0 to 18</b></li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>SINS Table (1)</h2><p class="small">Table 11.1 · Spinal Instability Neoplastic Score</p><div class="grp" style="--c:var(--blue);--i:0"><div class="gn">Location</div><div class="gi"><span class="it">Junctional: occiput–C2, C7–T2, T11–L1, L5–S1<b>3</b></span><span class="it">Mobile: C3–C6, L2–L4<b>2</b></span><span class="it">Semi-rigid: T3–T10<b>1</b></span><span class="it">Rigid: S2–S5<b>0</b></span></div></div><div class="grp" style="--c:var(--red);--i:1"><div class="gn">Pain: relief lying down and/or pain with movement or loading</div><div class="gi"><span class="it">Yes<b>3</b></span><span class="it">Occasional, not mechanical<b>1</b></span><span class="it">Pain-free lesion<b>0</b></span></div></div><div class="grp" style="--c:var(--grn);--i:2"><div class="gn">Bone lesion</div><div class="gi"><span class="it">Lytic<b>2</b></span><span class="it">Mixed (lytic/blastic)<b>1</b></span><span class="it">Blastic<b>0</b></span></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>SINS Table (2)</h2><p class="small">Table 11.1 continued</p><div class="grp" style="--c:var(--blue);--i:0"><div class="gn">Radiographic alignment</div><div class="gi"><span class="it">Subluxation / translation<b>4</b></span><span class="it">De novo deformity (kyphosis / scoliosis)<b>2</b></span><span class="it">Normal alignment<b>0</b></span></div></div><div class="grp" style="--c:var(--org);--i:1"><div class="gn">Vertebral body collapse</div><div class="gi"><span class="it">&gt; 50% collapse<b>3</b></span><span class="it">&lt; 50% collapse<b>2</b></span><span class="it">No collapse, &gt; 50% of body involved<b>1</b></span><span class="it">None of the above<b>0</b></span></div></div><div class="grp" style="--c:var(--grn);--i:2"><div class="gn">Posterolateral elements involved (facet, pedicle, or CV joint fracture or replaced by tumor)</div><div class="gi"><span class="it">Bilateral<b>3</b></span><span class="it">Unilateral<b>1</b></span><span class="it">None<b>0</b></span></div></div><p class="small">SINS = spinal instability neoplastic score; CV = costovertebral.</p></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>SINS: Interpretation</h2><p class="small">Total score 0 to 18</p><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">0–6<small><b>Stable</b></small></div><div class="box" style="--i:1;background:var(--org)">7–12<small><b>Potentially unstable</b></small></div><div class="box" style="--i:2;background:var(--red)">13–18<small><b>Unstable</b></small></div></div><div class="key">A patient with a score <b>more than 7</b> should be assessed by a <b>spinal surgeon</b>.</div></div></article></div></section><section class="sec" id="sec-vas" style="--k:var(--red)"><header><h2>Spinal vascular disorders</h2><span class="cnt">5 cards · 6 flashcards</span></header><div class="hooks"><div class="hook"><b>I = dural AVF</b> (70–80%, low flow, congestion). <b>II glomus · III juvenile · IV pial AVF</b> = high flow, bleed (75%).</div><div class="hook">Cavernoma = <b>popcorn</b> on T2 with a dark rim.</div></div><div class="grid"><article class="card" style="--k:var(--org)"><div class="in"><h2>Spinal Vascular Disorders</h2><p class="small">11.7</p><ul class="pts"><li>The cord has vessels <b>interwoven with neuronal and glial elements</b></li><li>Disrupted vasculature shows up as:</li></ul><div class="chips"><span class="chip" style="--i:0">Arteriovenous malformations (AVMs)</span><span class="chip" style="--i:1">Dural arteriovenous fistulas (AVFs)</span><span class="chip" style="--i:2">Cavernomas</span><span class="chip" style="--i:3">Hemangiomas</span><span class="chip" style="--i:4">Aneurysms (rarely)</span></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Vascular Malformations</h2><p class="small">11.7.1</p><ul class="pts"><li><b>Spinal AVMs and dural AVFs</b> are the most common</li><li><b>Gold standard imaging:</b> spinal cord <b>angiography</b>, often after screening with <b>MR angiography (MRA)</b></li><li><b>Anson and Spetzler</b> classically described <b>four types</b></li></ul><div class="key"><b>Type I = dural AVF.</b> Most common type: <b>70% to 80%</b> of spinal vascular disorders. A <b>direct fistulous connection</b> between a <b>radiculomeningeal artery</b> and a <b>radicular vein</b>.</div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Type I: Dural AVF</h2><figure class="fig"><img alt="Fig. 11.4 · Spinal dural AVF: (a) sagittal T2, (b) contrast T1, (c) MRA MIP, (d–f) coronal MRA." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 11.4 · Spinal dural AVF: (a) sagittal T2, (b) contrast T1, (c) MRA MIP, (d–f) coronal MRA.</figcaption></figure><ul class="pts"><li>The fistula is usually along the <b>dorsal root sleeve</b></li><li><b>“Low flow”</b> lesions (low-pressure gradient)</li><li><b>Rarely bleed</b>, but cause <b>venous congestion</b> → <b>edema and ischemia</b> of the cord</li><li>Symptoms: <b>LBP, radiculopathy, bladder symptoms</b>, or <b>cauda equina syndrome</b></li><li>Endovascular and/or open surgery: <b>excellent results</b>; strategy depends on the malformation’s anatomy</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">70–80%</div><div class="l">of spinal vascular disorders</div></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Types II, III, IV</h2><p class="small">Fig. 11.4: spinal dural AVF imaging (MRI and MRA)</p><div class="rc" style="--c:var(--red);--i:0"><div class="nm">Type II</div><div class="tx"><b>Glomus AVM</b>: intramedullary <b>nidus of tightly packed vessels</b>, supplied by anterior and/or posterior spinal circulation<em></em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">Type III</div><div class="tx"><b>Juvenile</b> intramedullary and extramedullary AVM<em></em></div></div><div class="rc" style="--c:var(--blue);--i:2"><div class="nm">Type IV</div><div class="tx"><b>AVF of the pia mater</b>: spinal artery and spinal vein communicate <b>without a capillary network</b><em></em></div></div><ul class="pts"><li>II, III, IV = <b>“high-flow.”</b> <b>75%</b> present acutely after <b>hemorrhage</b>; <b>worse prognosis</b> than type I</li><li>Intramedullary: usually <b>endovascular</b> treatment; asymptomatic patients can be <b>followed conservatively</b></li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Cavernomas</h2><p class="small">11.7.2</p><ul class="pts"><li><b>5% to 12%</b> of spinal vascular pathology; only <b>3% to 5%</b> of CNS cavernomas are in the cord</li><li>Present with <b>acute intraparenchymal hemorrhage</b> or <b>progressive decline</b> after multiple microhemorrhages</li><li>Bleeding risk: <b>9.5%</b> in symptomatic patients vs. <b>0.8%</b> in asymptomatic</li></ul><div class="key"><b>MRI</b> is the imaging modality of choice: <b>hyperintense T2</b> lesion (<b>“popcorn lesion”</b>) with a <b>hypointense rim</b>.</div><ul class="pts"><li><b>Surgical resection</b> is the primary treatment for symptomatic lesions; <b>conservative</b> care is sometimes used when a single bleed is followed by <b>complete resolution</b> of symptoms</li></ul></div></article></div></section><section class="sec" id="sec-def" style="--k:var(--blue)"><header><h2>Spinal deformity</h2><span class="cnt">13 cards · 10 flashcards</span></header><div class="hooks"><div class="hook"><b>SVA:</b> plumb from <b>C7</b> → passes <b>L1</b> and the back of the <b>L5–S1 disc</b>; within <b>6 cm</b> of the sacral end plate.</div><div class="hook"><b>40–50–60 rule</b> = cervical / thoracic / lumbar angles. <b>Kyphosis trimodal:</b> teen Scheuermann · 40s–60s AS · &gt;60 degenerative.</div><div class="hook">Scoliosis: <b>&lt;20° watch · 20–30° brace · &gt;30° consider surgery</b>. Adult degenerative: <b>3°/year</b>, surgery &gt;45°.</div></div><div class="grid"><article class="card" style="--k:var(--org)"><div class="in"><h2>Spinal Deformity</h2><p class="small">11.8</p><div class="side"><div class="art"><svg width="150" height="230" viewBox="0 0 60 120"><path d="M30 4C18 12 18 22 28 28C42 36 42 52 28 62C16 72 18 88 30 96C36 102 36 110 32 116" fill="none" stroke="#2f6fd0" stroke-width="6" stroke-linecap="round"/><text x="40" y="20" font-size="7" font-weight="700" fill="#8c8472">C lordosis</text><text x="42" y="46" font-size="7" font-weight="700" fill="#8c8472">T kyphosis</text><text x="42" y="84" font-size="7" font-weight="700" fill="#8c8472">L lordosis</text></svg></div><div class="main"><ul class="pts"><li>The spine gets <b>rotational and translational forces</b> along axial, coronal, and sagittal axes</li><li>Eccentric loads apply rotational force → <b>shearing, compression, distraction</b> → degeneration and deformity in sagittal, coronal, or axial planes</li><li>Normal column: <b>cervical lordosis, thoracic kyphosis, lumbar lordosis, sacral angulation</b>: they neutralize each other so head and trunk sit <b>over the pelvis</b></li></ul></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Sagittal Balance (SVA)</h2><ul class="pts"><li>Evaluation: <b>standing 36-inch AP and lateral long films</b>, hips and knees extended</li><li>Common measurements: <b>sagittal balance</b> and <b>Cobb angle</b></li></ul><div class="key"><b>SVA:</b> on a lateral X-ray drop a <b>plumb line</b> (vertical to the floor) from the <b>center of C7</b>; it should pass through <b>L1</b> and the <b>posterior aspect of the L5–S1 disc space</b>.</div><div class="stats"><div class="stat" style="--i:0"><div class="n">≤ 6 cm</div><div class="l">normal SVA from posterior superior sacral end plate</div></div></div><ul class="pts"><li>Then evaluate <b>angulation of each segment</b> on lateral long X-ray</li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Cobb Angle: Sagittal</h2><p class="small">Fig. 11.5</p><ul class="pts"><li><b>Cobb angle:</b> angle between lines drawn <b>perpendicular to the top of the rostral vertebra</b> and the <b>bottom of the caudal vertebra</b> (along the end plates) of the measured segment</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">40 ± 9.7°</div><div class="l">cervical lordosis</div></div><div class="stat" style="--i:1"><div class="n">20–50°</div><div class="l">thoracic kyphosis</div></div><div class="stat" style="--i:2"><div class="n">31–79°</div><div class="l">lumbar lordosis</div></div></div><div class="key">Accounts for the commonly accepted <b>“40–50–60” rule</b> for cervical, thoracic, lumbar angulation. Some studies suggest this may <b>overestimate</b> the normal range.</div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Cobb Angle: Coronal</h2><p class="small">AP view · coronal balance</p><figure class="fig"><img alt="Fig. 11.5 · Cobb angle: apex and the most tilted vertebrae above and below it." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 11.5 · Cobb angle: apex and the most tilted vertebrae above and below it.</figcaption></figure><ul class="pts"><li>Normal: <b>0 degrees</b> of angulation in any segment</li><li>With angulation: Cobb from the <b>top of the rostral vertebra involved</b> to the <b>bottom of the most caudal vertebra involved</b></li><li><b>Apical vertebra:</b> greatest rotation or furthest deviation from the midline</li><li><b>Neutral vertebra:</b> first vertebra on AP where <b>both pedicles are equally visualized</b> (no rotation)</li><li><b>Stable vertebra:</b> first one <b>bisected by the central sacral vertical line</b></li><li>Identifying these landmarks is <b>critical to operative planning</b></li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Spinopelvic Parameters (1)</h2><p class="small">Prognostic indicators for adult spinal deformity (Fig. 11.6)</p><figure class="fig"><img alt="Fig. 11.6 · Spinopelvic parameters: SVA, thoracic kyphosis, lumbar lordosis, sacral slope, pelvic tilt, pelvic incidence." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 11.6 · Spinopelvic parameters: SVA, thoracic kyphosis, lumbar lordosis, sacral slope, pelvic tilt, pelvic incidence.</figcaption></figure><div class="rc" style="--c:var(--blue);--i:0"><div class="nm">PI: pelvic incidence</div><div class="tx">Angle between a line <b>perpendicular to the S1 end plate at its midpoint</b> and the line from that point to the <b>femoral head axis</b><em></em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">PT: pelvic tilt</div><div class="tx">Angle between the line from the <b>midpoint of the superior sacral plate to the femoral head axis</b> and a <b>vertical reference line</b><em></em></div></div><div class="rc" style="--c:var(--grn);--i:2"><div class="nm">Sacral slope</div><div class="tx">Angle between a <b>horizontal line and the sacral plate</b><em></em></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Spinopelvic Parameters (2)</h2><p class="small">Fig. 11.7: cervical SVA and chin–brow vertical angle</p><figure class="fig"><img alt="Fig. 11.7 · (a) Cervical SVA measurements. (b) Chin–brow vertical angle (CBVA)." loading="lazy" src="data:image/jpeg;base64,"><figcaption>Fig. 11.7 · (a) Cervical SVA measurements. (b) Chin–brow vertical angle (CBVA).</figcaption></figure><div class="rc" style="--c:var(--red);--i:0"><div class="nm">PI-LL</div><div class="tx">The <b>offset between PI and lumbar lordosis</b><em></em></div></div><div class="rc" style="--c:var(--blue);--i:1"><div class="nm">SVA</div><div class="tx">Linear offset of the <b>C7 vertebra</b> against the <b>posterosuperior corner of S1</b>; assesses <b>global sagittal alignment</b><em></em></div></div><div class="key"><b>SVA, PT, and PI-LL</b> are most strongly associated with <b>clinical outcomes</b>. Three broad categories of deformity: <b>kyphosis, lordosis, scoliosis</b>, and combinations.</div><div class="key"><b>Fig. 11.7a (cervical SVA):</b> <b>green arrow</b> = C1–C7 SVA (plumb line from the anterior tubercle of C1 to the posterior superior corner of C7). <b>Red arrow</b> = C2–C7 SVA (plumb line from the centroid of C2). <b>Yellow arrow</b> = center of gravity to C7 SVA (plumb line from the anterior margin of the external auditory canal).</div><div class="key"><b>Fig. 11.7b: CBVA</b> (chin–brow vertical angle) = the angle between a line from the patient’s <b>chin to brow</b> and a <b>vertical line</b> (standing, hips and knees extended, neck neutral or flexed).</div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Kyphosis (1)</h2><p class="small">11.8.1</p><ul class="pts"><li><b>Pathological accentuation</b> of the normal sagittal contour of the thoracic and/or sacral spine</li><li>With coronal abnormalities: <b>kyphoscoliosis</b></li><li>Thoracic Cobb angle <b>&lt; 40°</b> is generally normal</li><li>Can cause <b>pain and cosmetic deformity</b>; severe cases: <b>neurological deficits and cardiopulmonary problems</b></li><li><b>Pain and disability</b> are more common in <b>adult</b> kyphosis</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">&lt; 40°</div><div class="l">normal thoracic Cobb angle</div></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Kyphosis (2)</h2><p class="small">Causes and age distribution</p><ul class="pts"><li><b>Scheuermann’s disease:</b> osteochondrosis of the spine in adolescents; pain and neurological symptoms; <b>5 degrees of wedging at each level over three consecutive vertebrae</b></li><li>Adult kyphosis: <b>degenerative, inflammatory, traumatic, oncological, or infective</b> disorders</li><li><b>Trimodal</b> age distribution:</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--blue)">Adolescents<small>Scheuermann’s kyphosis</small></div><div class="box" style="--i:1;background:var(--org)">4th–6th decades<small>Ankylosing spondylitis or other inflammatory disorders</small></div><div class="box" style="--i:2;background:var(--grn)">&gt; 60 years<small>Degenerative changes</small></div></div></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Kyphosis (3)</h2><p class="small">Diagnosis and flexibility</p><ul class="pts"><li>Thoracic diagnosis: <b>standing 36-inch lateral radiographs</b>, hips and knees extended, with a <b>Cobb angle &gt; 40°</b></li><li><b>Sagittal balance</b> should be routinely assessed</li><li>Assess <b>flexibility</b>: lateral film <b>supine over a bolster</b></li><li>Correction to <b>50° or less</b> = <b>flexible</b>: often corrected with a <b>posterior-only fusion</b></li><li><b>Rigid</b> deformities frequently need <b>combined anterior and posterior</b> procedures</li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Lordosis</h2><p class="small">11.8.2</p><ul class="pts"><li>Most common pathological lordosis: <b>lumbar hyperlordosis</b>, prevalent in <b>dancers</b></li><li>Other causes: <b>obesity, hyperkyphosis, discitis, Ehlers–Danlos syndrome, benign juvenile lordosis</b></li><li>Associated with <b>axial back pain</b> and is usually managed with <b>conservative treatment</b></li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Scoliosis (1)</h2><p class="small">11.8.3 · adolescent and adult</p><ul class="pts"><li>Scoliosis and kyphoscoliosis occur in <b>adolescent (idiopathic)</b> and <b>adult (degenerative)</b> populations</li><li>Rare <b>juvenile idiopathic</b> scoliosis: children <b>younger than 10</b> who are skeletally immature</li><li>Classic definition: <b>Cobb angle &gt; 10°</b> in the coronal plane (any coronal angulation can be pathological)</li><li>Two phases: <b>curve initiation and progression</b></li><li><b>Bone growth is inhibited by pressure on the growth plate</b>; the normally kyphotic thoracic spine loads the <b>ventral</b> vertebral bodies more. If there is <b>rotation</b>, pressure on the growth plate is <b>uneven</b> → scoliosis</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Scoliosis: Adolescent Treatment</h2><ul class="pts"><li>Up to <b>95%</b> of adolescent idiopathic cases progress; about <b>70%</b> need surgery</li><li>Management: <b>observation, orthosis, or surgery</b></li><li>Curve type by the <b>Lenke classification</b> (with lumbar spine and sagittal thoracic modifiers)</li></ul><div class="boxes"><div class="box" style="--i:0;background:var(--grn)">&lt; 20°<small>Observe</small></div><div class="box" style="--i:1;background:var(--org)">20–30°<small>Bracing</small></div><div class="box" style="--i:2;background:var(--red)">&gt; 30°<small>May be surgically managed (consider bone maturity and clinical state)</small></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Adult Degenerative Scoliosis</h2><ul class="pts"><li>A <b>clinically separate entity</b>: disability and pain from <b>radiculopathy due to stenosis in the concavity of the major curve</b></li><li>Can progress about <b>3 degrees per year</b></li><li><b>Surgery</b> for coronal angulation <b>more than 45°</b></li><li>Historically, extensive fusions with significant morbidity; recent studies suggest <b>smaller two- or three-level fusions</b> may be enough for a subset of patients</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">3°/yr</div><div class="l">progression</div></div><div class="stat" style="--i:1"><div class="n">&gt; 45°</div><div class="l">surgery recommended</div></div></div></div></article></div></section><section class="sec" id="sec-inf" style="--k:var(--grn)"><header><h2>Inflammatory disease and infections</h2><span class="cnt">9 cards · 5 flashcards</span></header><div class="hooks"><div class="hook">AS: <b>bamboo spine</b>, Romanus lesion, pain <b>better with exercise</b>. RA neck: <b>49% atlantoaxial · 38% odontoid up · 10–20% subaxial</b>.</div><div class="hook">Epidural abscess: <b>fever + back pain + deficit</b>, <i>S. aureus</i>, MRI. VBO: IV antibiotics <b>4–6 wk</b> then oral <b>2–6 wk</b>. Pott’s: <b>anterior</b> destruction → kyphosis.</div></div><div class="grid"><article class="card" style="--k:var(--grn)"><div class="in"><h2>Ankylosing Spondylitis</h2><p class="small">11.9.1 · inflammatory spondyloarthropathy</p><ul class="pts"><li>Inflammatory disease of the joints of the <b>spine and/or pelvis</b>, <b>strong genetic</b> component</li><li><b>Back pain and stiffness</b> that characteristically <b>improves with exercise</b>; enthesitis, arthritis, constitutional signs, fatigue</li><li>Extra-articular: <b>uveitis and cardiovascular disease</b></li><li>X-ray: <b>squaring</b> and loss of normal concave vertebral contour; <b>syndesmophytes</b> → <b>“bamboo spine”</b> and fused sacroiliac joints</li><li><b>Romanus lesion:</b> sclerosis of upper and lower vertebral limits</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>AS: Imaging and Treatment</h2><ul class="pts"><li><b>MRI and CT</b> may show early <b>sacroiliitis and enthesitis</b> → earlier diagnosis</li><li><b>Medical:</b> NSAIDs, sulfasalazine, corticosteroids, <b>TNF-α inhibitors</b></li><li><b>Surgery</b> can be considered with <b>complete fusion of a segment</b>, but is challenging, especially in <b>trauma</b> with <b>anesthetic difficulties</b></li><li>These patients may benefit from <b>osteotomy</b> of the vertebral bodies</li></ul></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Rheumatoid Arthritis: Cervical Spine</h2><p class="small">11.9.2</p><ul class="pts"><li>Commonly presents in the cervical spine. Most common pathologies:</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">49%</div><div class="l">atlantoaxial subluxation</div></div><div class="stat" style="--i:1"><div class="n">38%</div><div class="l">superior migration of the odontoid</div></div><div class="stat" style="--i:2"><div class="n">10–20%</div><div class="l">subaxial subluxation</div></div></div><ul class="pts"><li><b>25% to 80%</b> develop cervical involvement; only a <b>minority</b> have neurological symptoms</li><li>Presentations: <b>facial pain, ear pain, occipital neuralgia, myelopathy, vertebrobasilar insufficiency</b></li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>RA: Ranawat Classification</h2><p class="small">Clinical picture</p><div class="rc" style="--c:var(--grn);--i:0"><div class="nm">Class I</div><div class="tx"><b>Pain</b> with no neurologic deficit<em></em></div></div><div class="rc" style="--c:var(--org);--i:1"><div class="nm">Class II</div><div class="tx"><b>Subjective weakness</b>, hyperreflexia, dysesthesias<em></em></div></div><div class="rc" style="--c:var(--red);--i:2"><div class="nm">Class IIIA</div><div class="tx"><b>Objective weakness</b>, long tract signs, <b>ambulatory</b><em>Class III: with objective problems</em></div></div><div class="rc" style="--c:var(--red);--i:3"><div class="nm">Class IIIB</div><div class="tx"><b>Objective weakness</b>, long tract signs, <b>nonambulatory</b><em></em></div></div><ul class="pts"><li>Surgery depends on symptoms and imaging; <b>symptomatic</b> pathologies may need intervention. Controversial whether <b>minimal symptoms with radiographic instability</b> need surgery</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Epidural Spinal Abscess</h2><p class="small">11.10.1 · spinal infections</p><ul class="pts"><li><b>2.8 cases per 100,000</b> admissions; rising in the <b>IV drug abusing</b> population</li><li>Local mass effect + <b>vascular compromise</b> of the cord → pain and neurologic deficits, then <b>cord ischemia</b></li><li>Four stages: <b>1.</b> axial back pain at the affected level <b>2.</b> radicular pain <b>3.</b> motor/sensory abnormalities and bladder/bowel dysfunction <b>4.</b> paralysis</li></ul><div class="key">The most common pathogen is <b><i>Staphylococcus aureus</i></b>.</div><div class="stats"><div class="stat" style="--i:0"><div class="n">2.8</div><div class="l">per 100,000 admissions</div></div></div></div></article><article class="card" style="--k:var(--red)"><div class="in"><h2>Epidural Abscess: Management</h2><ul class="pts"><li><b>Classic triad:</b> fever, back pain, neurological deficit</li><li>Suspect it → <b>urgent spinal MRI</b> (ideally with contrast)</li><li><b>Medical and surgical</b> management both possible; <b>surgery</b> if neurological status is impaired or the spine is unstable</li><li>Pathogens: <b>S. aureus</b> (MRSA with implantable devices or vascular disease), <b>S. epidermidis, Pseudomonas aeruginosa</b>, anaerobes, mycobacteria, fungi, parasites</li><li>Pain only, no deficit or instability: <b>empiric antistaphylococcal</b> antibiotics, tailored to cultures</li><li>Stable patients without deficits: <b>CT-assisted aspiration</b>; clinical deterioration → <b>decompression</b></li></ul></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>Vertebral Body Osteomyelitis</h2><p class="small">11.10.2 · VBO</p><ul class="pts"><li>The <b>most common form of infection</b> of the vertebral column; pyogenic VBO mostly in <b>older people with comorbidities</b> (diabetes, alcoholism, renal or liver failure, cancer, immunosuppression) and <b>younger IV drug abusers</b></li><li>Symptoms are <b>nonspecific</b>; <b>no fever in 40%</b></li><li>Most common organisms: <b><i>S. aureus</i></b>, then <b><i>E. coli</i></b></li><li><b>CT</b> shows <b>bone erosion</b>; <b>MRI</b> helps with earlier detection of osteomyelitis and abscess</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">40%</div><div class="l">no fever</div></div></div></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>VBO: Treatment</h2><ul class="pts"><li>Uncomplicated VBO: <b>IV antibiotics 4 to 6 weeks</b>, then <b>oral antibiotics for a further 2 to 6 weeks</b></li><li><b>Bed rest and/or external orthosis</b> can be considered</li><li><b>Surgery</b> for <b>biopsy</b>, symptomatic cord compression, or refractory severe pain</li><li>Follow-up imaging has <b>not</b> been shown to correlate with better results: follow patients <b>clinically</b> for response to antibiotics</li></ul></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Pott’s Disease</h2><p class="small">11.10.3 · spinal tuberculosis (osteomyelitis and arthritis)</p><ul class="pts"><li><b>Adults:</b> spreads from the <b>anterior aspect</b> of the vertebra. <b>Children:</b> hematogenous, mainly the <b>intervertebral discs</b></li><li>Anterior vertebral destruction → <b>kyphosis</b>, plus <b>abscess</b> formation and <b>cord compression</b></li><li>Work-up: <b>tuberculin (purified protein derivative) test, QuantiFERON-TB Gold</b>, percutaneous <b>CT-guided biopsy</b> for culture</li><li><b>MRI</b> is the gold standard: <b>thin, smooth</b> enhancement of the abscess wall + a <b>well-defined paraspinal signal</b></li><li><b>Antituberculous drugs</b>; surgery with <b>neurological deficits or instability</b></li></ul></div></article></div></section><section class="sec" id="sec-ces" style="--k:var(--red)"><header><h2>Cauda equina and tethered cord</h2><span class="cnt">4 cards · 2 flashcards</span></header><div class="hooks"><div class="hook">CES: <b>saddle anesthesia + bladder/bowel</b> + legs; <b>MRI</b>; decompress within <b>24–48 h</b>.</div><div class="hook">Tethered cord: thick <b>filum terminale</b>; stigmata (hairy patch, dimples); <b>untether</b> early.</div></div><div class="grid"><article class="card" style="--k:var(--red)"><div class="in"><h2>Cauda Equina Syndrome</h2><p class="small">11.11</p><ul class="pts"><li>The cord tapers and ends at about <b>L1</b>, forming the <b>cauda equina</b> (“horse’s tail”). Part of the <b>peripheral nervous system</b>, but its compression can cause <b>irreversible deficits</b>: an <b>emergency</b></li><li>Roots are especially vulnerable (<b>thin myelin sheath</b>)</li><li>Causes: <b>traumatic, degenerative, malignant</b>. <b>Degenerative lumbar disc disease</b> is common (<b>70%</b> had back pain before onset)</li><li><b>Neoplasms</b> are uncommon causes: myxopapillary ependymomas, schwannomas, paragangliomas</li></ul><div class="stats"><div class="stat" style="--i:0"><div class="n">L1</div><div class="l">cord ends</div></div><div class="stat" style="--i:1"><div class="n">70%</div><div class="l">back pain before CES</div></div></div></div></article><article class="card" style="--k:var(--blue)"><div class="in"><h2>CES: Symptoms and Treatment</h2><ul class="pts"><li><b>Symptoms:</b></li></ul><div class="chips"><span class="chip" style="--i:0">LBP</span><span class="chip" style="--i:1">Radiculopathy (more commonly unilateral)</span><span class="chip" style="--i:2">Saddle anesthesia</span><span class="chip" style="--i:3">Bowel/bladder incontinence or retention</span><span class="chip" style="--i:4">Bilateral lower extremity motor and sensory deficits</span><span class="chip" style="--i:5">Absent lower extremity reflexes</span></div><ul class="pts"><li>Suspect in acute LBP + <b>bowel or bladder changes</b>. <b>MRI of the lumbosacral spine</b> is the study of choice</li><li><b>Surgical decompression within 24 to 48 hours</b> of onset: laminectomy with neural decompression; <b>fusion</b> if stability is compromised; tumor resection in emergency cases when a neoplasm is the cause</li></ul></div></article><article class="card" style="--k:var(--org)"><div class="in"><h2>Tethered Cord Syndrome</h2><p class="small">11.12 · 11.12.1</p><ul class="pts"><li><b>Thickened filum terminale</b> tethers the <b>conus medullaris</b> to the dorsal spinal canal</li><li>Associated with <b>myelomeningoceles, scoliosis, VACTERL</b> (vertebral defects, anal atresia, cardiac defects, tracheoesophageal fistula, renal anomalies, limb abnormalities)</li><li>Symptoms: <b>deformities</b> and <b>weakness/gait disturbances</b> of the lower extremities, <b>bladder disorders, LBP, scoliosis</b>; <b>peripheral stigmata</b> (hairy patch, dimples)</li><li>Diagnosis: <b>MRI</b>; clinical judgment decides who benefits from surgery</li><li><b>Early surgery</b> prevents neurological deterioration: <b>untethering</b> the cord; occasionally a <b>spine-shortening vertebral osteotomy</b></li></ul></div></article><article class="card" style="--k:var(--grn)"><div class="in"><h2>Pearls: Spine</h2><ul class="pts"><li>A thorough <b>history and physical examination</b> can distinguish the etiologies of LBP: <b>degenerative, traumatic, spinal neoplasms, and infections</b></li><li>The most common spinal tumors are <b>vertebral body metastases</b>, and the <b>SINS score</b> is a validated tool to evaluate them</li><li>Assess spinal deformity on <b>standing 36-inch AP and lateral long films</b> by calculating <b>sagittal balance and Cobb angle</b></li><li>Acute LBP with <b>lower extremity weakness and bowel/bladder symptoms</b> → suspect <b>cauda equina syndrome</b>, a <b>surgical emergency</b></li></ul></div></article></div></section>
</div>
<div id="v-cards" hidden>
 <div class="fc">
  <div class="bar"><select id="fsel" aria-label="Section"></select><span class="meta" id="fmeta"></span></div>
  <div class="prog"><i id="fprog"></i></div>
  <div id="fbody"></div>
 </div>
</div>
<div id="v-quiz" hidden><div class="qz" id="qbody"></div></div>
</main>
<nav class="tabs" role="tablist"><button role="tab" aria-selected="true" data-t="sheets">Sheets</button><button role="tab" aria-selected="false" data-t="cards">Flashcards</button><button role="tab" aria-selected="false" data-t="quiz">Quiz</button></nav>
<script>
const CARDS=[["odo", "Odontoid (dens) fractures: how common, and what classification?", "The <b>most common C2 fractures</b> (<b>7–14%</b> of traumatic cervical spine injuries); often high cervical pain. <b>Anderson and D’Alonzo</b> classification: three types; guides treatment and assesses stability and healing potential."], ["odo", "Odontoid Type I", "Fracture of the <b>tip of the dens</b>. Generally <b>stable</b>, treated with a <b>collar</b>, unless <b>AOD</b> is present (then surgery or halo/collar immobilization)."], ["odo", "Odontoid Type II: where is the fracture?", "Where the odontoid meets the vertebral body. The <b>most common</b> odontoid fracture, with a high rate of <b>nonunion</b>."], ["odo", "Odontoid Type II: stable? treatment?", "Generally <b>unstable</b>: surgery or immobilization. If comminuted fragments are present it is unstable and surgery should be considered."], ["odo", "Odontoid Type III: fracture line, stability, treatment?", "Goes through the <b>vertebral body</b>; generally <b>stable</b>; <b>cervical collar</b> unless other injuries make the spine unstable."], ["odo", "What is a hangman’s fracture?", "Vertical or oblique fracture through the <b>C2 pars interarticularis</b>, disconnecting the posterior arch from the vertebral body."], ["odo", "Hangman’s: cause and what else to evaluate?", "<b>Hyperextension</b> (motor vehicle accident, diving). Evaluate the <b>posterior C1 ring</b> and the <b>C2–C3 disc</b>."], ["odo", "Hangman’s: treatment?", "Most isolated: <b>collar</b>. Displaced isolated: <b>halo brace</b>. Surgery if the <b>C2–C3 facets are locked</b> or other injuries make the spine unstable."], ["odo", "Levine–Edwards Type I", "Minimally displaced, <b>stable</b>, treated with immobilization."], ["odo", "Levine–Edwards Type II", "Displaced with angulation, <b>unstable</b>, may require surgery."], ["odo", "Levine–Edwards Type IIa", "Severe angulation, minimal displacement, <b>highly unstable</b>, usually requires surgery."], ["odo", "Levine–Edwards Type III", "Displaced with <b>facet dislocation</b>, highly unstable, requires surgical stabilization."], ["odo", "Isolated nondisplaced C2 lamina, body, or facet fractures?", "Generally stable; heal in a <b>collar</b>."], ["odo", "C2 fracture together with a C1 fracture?", "Needs careful evaluation for spinal <b>stability</b>."], ["sub", "Most commonly injured subaxial level?", "<b>C5–C6</b>."], ["sub", "Three kinds of subaxial cervical injury?", "<b>Compression</b>, <b>flexion/extension/distraction</b>, and <b>rotation</b>."], ["sub", "What does the SLICS score evaluate?", "<b>Morphology</b> of the injury, integrity of the <b>PLC</b>, and <b>neurological status</b>. Each gets a score; the total guides treatment (C3–C7)."], ["sub", "Anterior compression (wedge) fracture: mechanism and stability?", "Axial loading ± flexion/extension. <b>Stable</b>; generally heals with external immobilization."], ["sub", "Comminuted (burst) cervical fracture?", "Axial loading ± flexion. Generally <b>unstable</b>; fusion and decompression if needed."], ["sub", "Teardrop fracture?", "Hyperflexion-compression. <b>Unstable</b>: evaluate disc space and ligaments on MRI; fusion, decompress if needed."], ["sub", "When are flexion/extension/distraction injuries unstable?", "If the <b>PLL/posterior annulus fails AND</b> there is anterolisthesis, facet malalignment, end plate angulation <b>&gt;10°</b>, or vertebral segment distraction."], ["sub", "Whiplash with neurologic injury?", "Flexion/extension. <b>Stable</b>; management is controversial and can include a collar and physical therapy."], ["sub", "Severe whiplash (sprain)?", "Flexion/extension. Re-evaluate the integrity of the <b>posterior ligaments</b>; collar, physical therapy."], ["sub", "Bilateral facet fracture-dislocation?", "Distraction + flexion/extension with failure of the PLC. <b>Unstable</b>: closed or open reduction and internal fixation/fusion; MRI for herniated discs."], ["sub", "Unilateral facet fracture?", "Lateral flexion + rotation. <b>Stable</b> if no significant subluxation, dislocation, or kyphosis; collar."], ["sub", "Fracture separation of the articular pillar?", "Extension, compression + rotation. Evaluate other injuries to decide if stable; collar, halo, or surgery."], ["sub", "Unilateral dislocation?", "Lateral flexion + rotation. A <b>perched facet is unstable</b>: evaluate nerve root and cord injury; reduction and halo or fusion."], ["sub", "AO Spine subaxial classification: the three types?", "<b>A</b> compression, <b>B</b> tension band, <b>C</b> displacement/translation; also considers neurological status and PLC."], ["sub", "Jumped facets: mechanism of unilateral vs bilateral?", "Unilateral: spine <b>rotated</b>. Bilateral: usually <b>flexion or extension</b> disrupting the posterior ligaments."], ["sub", "Jumped facets: treatment?", "Unilateral: traction then halo or surgical fusion. Closed traction is controversial in bilateral. Generally anterior or posterior surgery with intraoperative reduction; some get MRI first for disc herniation."], ["sub", "Isolated ligamentous cervical injury without AOD?", "<b>Collar</b> alone; follow up in <b>4–6 weeks</b> (range of motion, tenderness). AOD = transverse ligament torn in its midportion."], ["sub", "What do plain radiographs miss in the neck?", "The <b>C7–T1</b> disc space and facets. Use CT and/or MRI if a junctional injury is a concern."], ["sub", "Which conditions predispose to cervical instability after trauma?", "Rheumatoid arthritis, Down syndrome, ankylosing spondylitis, others: need careful imaging and exam. Prior hardware: X-ray, CT, CT myelogram; MRI limited by artifact."], ["tl", "Where does the spinal cord generally end?", "<b>L1–L2</b>; the cauda equina fills the distal canal."], ["tl", "Thoracic cord lesion vs lesion below the cord end?", "Above: complete/incomplete paraplegia, bowel/bladder problems, <b>UMN</b> findings. Below: nerve roots, <b>LMN</b> findings."], ["tl", "Conus medullaris syndrome: level and features?", "<b>T12–L1</b>; sacral nerve root damage → bowel and bladder problems; some lumbar roots may be intact."], ["tl", "Denis minor injuries?", "Articulating process, transverse process, spinous process, pars interarticularis fractures. Generally <b>stable</b> (check for other injuries)."], ["tl", "Denis major injuries?", "Compression, burst, seatbelt-type, fracture-dislocation. Compression/burst <b>may</b> be stable; seatbelt and fracture-dislocation are generally <b>unstable</b>."], ["tl", "AO Spine thoracolumbar: types?", "<b>A</b> compression, <b>B</b> tension band, <b>C</b> translation/rotation. Based on morphology, PLC integrity, neurological status (T1–L5)."], ["tl", "TLICS decision thresholds?", "<b>&lt;4</b> nonoperative · <b>4</b> operative or nonoperative · <b>&gt;4</b> operative."], ["tl", "TLICS morphology points?", "Compression <b>1</b>, burst <b>2</b>, translation/rotation <b>3</b>, distraction <b>4</b>."], ["tl", "TLICS PLC points?", "Intact <b>0</b>, suspected/indeterminate <b>2</b>, injured <b>3</b>."], ["tl", "TLICS neurologic points?", "Intact 0; nerve root 2; cord/conus complete 2; cord/conus incomplete 3; cauda equina 3."], ["tl", "Thoracolumbar compression fracture: which columns?", "Anterior fails; middle intact (hinge); posterior may fail. More than one column = may be unstable."], ["tl", "Denis burst type A", "Both end plates fractured, no kyphosis; bone may retropulse. Pure axial load; usually lumbar."], ["tl", "Denis burst type B", "Superior end plate; <b>most common</b>. Axial load + flexion; thoracolumbar junction."], ["tl", "Denis burst type C", "Inferior end plate. Axial load + flexion; no particular site."], ["tl", "Denis burst type D", "Burst rotation: comminuted body, possible laminar fractures, retropulsion. Axial load + rotation; midlumbar."], ["tl", "Denis burst type E", "Burst lateral flexion: fractured posterior wall, extrusion toward the side of flexion. Axial load + lateral flexion."], ["tl", "Seatbelt-type injury: columns and eponym?", "<b>Middle and posterior fail</b> in flexion; anterior is a hinge. One-level: <b>Chance fracture</b> through body and neural arch with disc/PLL disruption."], ["tl", "Fracture-dislocation of the thoracolumbar spine?", "<b>All three columns fail</b> (compression, tension, rotation, or shear). Most require surgery."], ["sac", "Sacral fractures: mechanism and problems?", "Often shear forces. Can injure sacral roots/plexus, affect pelvic stability. Below S2 spares ambulation but may be unstable and painful; more medial = worse outcomes."], ["sac", "Denis zone I", "Lateral to foramina; <b>low</b> risk; typically conservative."], ["sac", "Denis zone II", "Through the foramina; <b>moderate</b> risk; surgery depending on displacement."], ["sac", "Denis zone III", "Medial to foramina; <b>high</b> risk of severe neurological damage; often surgical."], ["sac", "Roy-Camille types of zone 3 fractures?", "<b>1</b> kyphosis without translation · <b>2</b> retrolisthesis · <b>3</b> anterolisthesis · <b>4</b> upper sacral comminution."], ["deg", "How common is degenerative cervical myelopathy?", "Most common cause of spinal cord pathology in the elderly: <b>605 per million</b> in North America."], ["deg", "How common is cervical degenerative disease?", "About <b>two-thirds</b> of people; baseline radiographic disc degeneration <b>21.7%</b>."], ["deg", "What is the central mechanism of disc degeneration (Guiot)?", "Compromised <b>diffusion</b> of oxygen and nutrients through the disc → cell death."], ["deg", "Protrusion vs extrusion?", "Protrusion: nucleus deforms the annulus, no rupture. Extrusion: nucleus ruptures through the annulus."], ["deg", "Radiculopathy vs myelopathy in disc herniation?", "Radiculopathy: nerve impingement at the neuroforamen. Myelopathy: spinal cord compression."], ["deg", "Most common cervical disc levels?", "<b>C5–C6</b>, then C4–C5, then C6–C7."], ["deg", "MR findings of cervical disc herniation?", "Loss of nucleus pulposus signal on T2; migration into the canal compressing thecal sac/roots; narrowing of disc space."], ["deg", "When is CT myelography best?", "When MRI cannot be done (non-MR-compatible devices) or for calcification/ossification and osteophytes."], ["deg", "Positional relief in cervical radiculopathy?", "Holding the arm up on the same side, leaning the head away: increases foraminal area."], ["deg", "Signs supporting cervical myelopathy?", "Ataxia, gait disturbance, bowel/bladder dysfunction, poor fine motor; Babinski, Hoffmann, ankle clonus, hyperreflexia, increased leg tone."], ["deg", "Nonoperative treatment of cervical radiculopathy?", "Up to <b>6 weeks</b>: anti-inflammatories, transforaminal epidural steroids, physical therapy, traction."], ["deg", "Surgical indications in cervical disc herniation?", "Persistent radiculopathy, progressive symptoms, worsening neurological status, or myelopathy."], ["deg", "Most common operation for herniated cervical disc?", "<b>ACDF</b>; 10-year self-reported success <b>85–95%</b>."], ["deg", "Arthroplasty requirements?", "No significant posterior element degeneration; younger patients; <b>contraindicated</b> with appreciable facet disease."], ["deg", "Complications of anterior cervical surgery?", "Dysphagia, recurrent laryngeal palsy (hoarse), superior laryngeal palsy (weak voice), CSF leak, vascular injury, hematoma (airway), adjacent segment disease."], ["deg", "How do osteophytes cause symptoms?", "Stress on end plates after disc degeneration → ventral osteophytes compress cord/roots; uncinate hypertrophy → foraminal stenosis → radiculopathy."], ["deg", "Best imaging for osteophytes?", "<b>CT</b>; for the foramen, myelogram + postmyelogram CT."], ["deg", "Cervical facet OA: level and prevalence?", "Most at <b>C3–C5</b>; <b>57%</b> of adults ≥ 65 years."], ["deg", "Is 1–2 mm of cervical subluxation always a problem?", "No: may be well tolerated and cause no symptoms."], ["deg", "Facet pain patterns?", "Mid/lower cervical: posterior scapular region → shoulder girdle. Upper cervical: occipital pain and headache."], ["opll", "What is OPLL?", "Hypertrophy, calcification, ossification of the PLL (dorsal to body, ventral to cord). Cervical; men, elderly, Asian subpopulation."], ["opll", "OPLL types?", "Segmental, continuous, mixed, localized."], ["opll", "OPLL: CT vs MRI?", "CT diagnoses OPLL; MRI shows cord compression/foraminal stenosis but is unreliable for calcified PLL."], ["opll", "OPLL natural history?", "80% progress slowly; <b>17%</b> of initially asymptomatic develop myelopathy over <b>18 years</b>; &gt;<b>60%</b> canal stenosis predicts it."], ["opll", "Why is anterior OPLL surgery risky?", "Calcified PLL adheres to dura (no dissection plane) → dural tear/CSF leak, bleeding. ACDF may leave a thin “floating” ossified layer."], ["opll", "Posterior OPLL options and complications?", "Laminoplasty (axial neck pain), laminotomy (kyphosis), laminectomy + fusion. Overall complication rate <b>21.8%</b>."], ["thl", "Why is thoracic DDD less often symptomatic?", "Ribs splint the spine. Thoracic disc operations are only 0.14–4% of disc excisions."], ["thl", "Where do thoracic herniations occur most?", "<b>T8–T12</b> (more movement, less rotational resistance). 37% of older adults show herniation on MRI."], ["thl", "Why is the thoracic cord vulnerable?", "Kyphosis + dentate ligaments → ventral compression; limited anastomoses, <b>T3–T6</b> watershed → ischemia."], ["thl", "Thoracic disc approaches?", "Transthoracic-transpleural (thoracotomy), posterolateral (transpedicular, costotransversectomy), lateral. Only thoracotomy/thoracoscopy show the ventral dura."], ["thl", "Transthoracic approach results (Mulier and Debois)?", "<b>93%</b> neurological recovery but more pulmonary complications. Laminectomy abandoned (morbidity/mortality up to 50%)."], ["thl", "LBP statistics?", "Point prevalence <b>11.9%</b>; <b>80%</b> lifetime; ~150 million work days/year; acute &lt; 12 weeks."], ["thl", "Awake spinal surgery?", "Local anesthetic + epidural spinal injection, minimal sedation; spinal anesthetic 2 levels above; ≤ 2-level fusion, ≤ 3-level decompression."], ["neo", "Most common spinal neoplasm?", "<b>Metastases</b>, most commonly <b>extradural</b>."], ["neo", "Primary spinal tumors: distribution?", "69% benign: meningioma 29%, nerve sheath 24%, ependymoma 23%. Malignant: 64% 10-year survival."], ["neo", "Intramedullary tumors: histology?", "Ependymoma 30–60%, astrocytoma 30%, hemangioblastoma 2–8%, metastases 2%; most enhance on MRI."], ["neo", "Ependymoma facts?", "Most common conus tumor; adults &gt; children; CSF seeding; cysts; encapsulated → excision. Myxopapillary: conus/filum."], ["neo", "Nerve sheath tumor MRI sign?", "T1 <b>target</b>: Antoni A centre (decreased), Antoni B periphery (increased). Malignant change 2–6%."], ["neo", "Meningioma (spinal)?", "Second most common intradural extramedullary; <b>dural tail</b>; recurrence 2–7%."], ["neo", "Vertebral metastases facts?", "Lung and breast; 5–10% of cancer patients; vertebral column 85%; thoracic &gt; lumbosacral &gt; cervical; multilevel 20–35%."], ["neo", "SINS: six elements?", "Location, mechanical pain, bone lesion type, alignment, vertebral body collapse, posterolateral involvement."], ["neo", "SINS location scores?", "Junctional <b>3</b>, mobile <b>2</b>, semi-rigid <b>1</b>, rigid (sacrum) <b>0</b>."], ["neo", "SINS interpretation?", "<b>0–6</b> stable · <b>7–12</b> potentially unstable · <b>13–18</b> unstable. &gt;7: assess by a spinal surgeon."], ["vas", "Gold standard imaging for spinal vascular malformations?", "Spinal cord <b>angiography</b>, often after MRA screening."], ["vas", "Type I spinal vascular malformation?", "<b>Dural AVF</b>: 70–80%; radiculomeningeal artery → radicular vein; low flow; venous congestion, edema, ischemia; rarely bleeds."], ["vas", "Type II malformation?", "<b>Glomus</b> AVM: intramedullary nidus of tightly packed vessels."], ["vas", "Type III and IV?", "III: juvenile intramedullary + extramedullary AVM. IV: pial AVF, artery and vein communicate with no capillary network."], ["vas", "High-flow types?", "II, III, IV: 75% present with hemorrhage; worse prognosis; usually endovascular."], ["vas", "Spinal cavernoma: facts?", "5–12% of spinal vascular pathology; MRI <b>popcorn</b> (T2 hyperintense, hypointense rim); bleed risk 9.5% symptomatic vs 0.8% asymptomatic."], ["def", "Normal sagittal vertical axis?", "Plumb line from <b>C7</b> passes L1 and back of L5–S1; within <b>6 cm</b> of the posterior superior sacral end plate."], ["def", "Cobb angle and normal values?", "Lines perpendicular to the top of the rostral and bottom of the caudal vertebra. Cervical 40 ± 9.7°, thoracic 20–50°, lumbar 31–79° (“40–50–60”)."], ["def", "Apical, neutral, stable vertebra?", "Apical: most rotation/deviation. Neutral: first with pedicles equally seen. Stable: first bisected by the central sacral vertical line."], ["def", "PI, PT, sacral slope?", "PI: S1 plate perpendicular vs femoral head axis. PT: sacral plate midpoint–femoral head line vs vertical. Sacral slope: horizontal vs sacral plate."], ["def", "Spinopelvic parameters best linked to outcomes?", "<b>SVA, PT, PI-LL</b>."], ["def", "Kyphosis age distribution?", "Trimodal: adolescents (Scheuermann), 40s–60s (AS/inflammatory), &gt;60 (degenerative)."], ["def", "Scheuermann criteria?", "<b>5°</b> wedging at each level over <b>three</b> consecutive vertebrae."], ["def", "Kyphosis flexibility?", "Correction to ≤ 50° on supine bolster = flexible → posterior-only fusion; rigid → combined anterior + posterior."], ["def", "Scoliosis definition and treatment by Cobb angle?", "Cobb &gt; 10°. &lt;20° observe; 20–30° brace; &gt;30° may be surgical. AIS: 95% progress, ~70% need surgery."], ["def", "Adult degenerative scoliosis?", "Radiculopathy from stenosis in the concavity; progresses ~3°/year; surgery &gt; 45°."], ["inf", "Ankylosing spondylitis features?", "Back pain/stiffness improving with exercise; squaring, syndesmophytes → bamboo spine; Romanus lesion; uveitis, cardiovascular disease; sacroiliitis on MRI."], ["inf", "Rheumatoid cervical spine?", "Atlantoaxial subluxation <b>49%</b>, odontoid superior migration <b>38%</b>, subaxial <b>10–20%</b>. Ranawat: I pain; II subjective weakness; IIIA objective weakness ambulatory; IIIB nonambulatory."], ["inf", "Epidural abscess: triad, stages, organism?", "Fever, back pain, neurological deficit. Stages: back pain → radicular pain → motor/sensory/bladder → paralysis. <i>S. aureus</i> (MRSA with devices). Urgent MRI."], ["inf", "Vertebral body osteomyelitis: treatment?", "IV antibiotics <b>4–6 weeks</b> then oral <b>2–6 weeks</b>; surgery for biopsy, cord compression, refractory pain. 40% have no fever."], ["inf", "Pott’s disease?", "Spinal TB: anterior vertebral destruction → <b>kyphosis</b>, abscess, cord compression. MRI gold standard (thin, smooth wall enhancement). Antituberculous drugs; surgery for deficit or instability."], ["ces", "Cauda equina syndrome: features and treatment?", "Cord ends ~L1. LBP, radiculopathy, <b>saddle anesthesia</b>, bowel/bladder, bilateral leg deficits, absent reflexes. MRI; decompression within <b>24–48 h</b>."], ["ces", "Tethered cord syndrome?", "Thickened filum terminale tethers the conus; myelomeningocele, scoliosis, VACTERL; stigmata; MRI; early untethering."]],QUIZ=[["An elderly man with a history of untreated cervical stenosis falls down the stairs and immediately complains of numbness and tingling in his hands and weak grip. What is the most likely diagnosis?", ["Unilateral jumped facet.", "Central cord syndrome.", "Atlantoaxial subluxation.", "Compression fracture of the C6 vertebra."], 1, "Classic presentation of central cord syndrome: distal greater than proximal deficits, and many patients have pre-existing cervical stenosis."], ["A 25-year-old man is extricated from a burning vehicle, unconscious, intubated, with a cervical collar. CT head and CT cervical spine are negative. Injuries: lower extremity fractures and a pneumothorax. He is awake and alert 2 days later. Best way to assess the need for his cervical collar?", ["Confrontational exam only.", "Flexion-extension films only.", "Confrontational exam and MRI.", "Repeat CT."], 2, "He cannot rely on a confrontational exam alone because of other painful injuries. Pain on confrontation may indicate ligamentous injury, confirmed or ruled out by MRI."], ["Which of the following injuries will most likely require operative intervention?", ["A unilateral facet fracture at C4–C5 with intact ligaments on MRI.", "Unilateral transverse process fractures at L2 and L3.", "An isolated C7 superior end plate fracture.", "Bilateral facet fractures at C4–C5."], 3, "Bilateral facet fractures result in an unstable spine and need instrumentation to restore stability."], ["The spinopelvic parameter defined as the angle between the perpendicular to the sacral plate at its midpoint and the line connecting this point to the femoral head axis is:", ["Pelvic incidence.", "Pelvic tilt.", "Sacral slope.", "Sagittal vertical axis."], 0, "This is the pelvic incidence."], ["The most commonly isolated bacterial species in patients with vertebral body osteomyelitis is:", ["E. coli", "S. aureus", "P. aeruginosa", "S. epidermidis"], 1, "S. aureus is the most common species isolated, followed by E. coli."], ["According to Anson and Spetzler, “low-flow” spinal vascular malformations are:", ["Type 1 (dural AVFs)", "Type 2 (glomus AVMs)", "Type 3 (juvenile intramedullary and extramedullary AVMs)", "Type 4 (pial AVFs)"], 0, "Type 1 (dural AVFs) are low-flow. Types 2, 3, and 4 are high-flow."]],SECS=[["odo", "C2 fractures: odontoid, hangman’s", "var(--red)"], ["sub", "Subaxial cervical injuries (C3–C7)", "var(--blue)"], ["tl", "Thoracic and thoracolumbar trauma", "var(--org)"], ["sac", "Sacral fractures and trauma pearls", "var(--grn)"], ["deg", "Cervical degenerative disease", "var(--blue)"], ["opll", "OPLL (ossified PLL)", "var(--red)"], ["thl", "Thoracic and lumbar degenerative disease", "var(--grn)"], ["neo", "Spinal neoplasms", "var(--org)"], ["vas", "Spinal vascular disorders", "var(--red)"], ["def", "Spinal deformity", "var(--blue)"], ["inf", "Inflammatory disease and infections", "var(--grn)"], ["ces", "Cauda equina and tethered cord", "var(--red)"]];
const $=s=>document.querySelector(s);
function tab(t){['sheets','cards','quiz'].forEach(x=>{$('#v-'+x).hidden=x!==t});document.querySelectorAll('.tabs button').forEach(b=>b.setAttribute('aria-selected',b.dataset.t===t));scrollTo(0,0);if(t==='cards')fcRender();if(t==='quiz'&&!qs.started)qRender()}
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>tab(b.dataset.t));
document.querySelectorAll('#chips button').forEach(b=>b.onclick=()=>{const e=document.getElementById('sec-'+b.dataset.s);if(e)e.scrollIntoView({behavior:'smooth',block:'start'})});
$('#q').oninput=e=>{const v=e.target.value.trim().toLowerCase();document.querySelectorAll('.card').forEach(c=>{c.hidden=v&&!c.textContent.toLowerCase().includes(v)});document.querySelectorAll('.sec').forEach(s=>{s.hidden=!!v&&![...s.querySelectorAll('.card')].some(c=>!c.hidden)})};
/* flashcards: Leitner boxes */
let sr={};try{sr=JSON.parse(localStorage.getItem('spine-sr')||'{}')}catch(e){}
function save(){try{localStorage.setItem('spine-sr',JSON.stringify(sr))}catch(e){}}
const DAY=864e5,IV=[0,1,3,7,16,35];
const sel=$('#fsel');sel.innerHTML='<option value="all">All sections</option>'+SECS.map(s=>`<option value="${s[0]}">${s[1]}</option>`).join('');
let queue=[],cur=-1,shown=false,review=false;
sel.onchange=()=>{review=false;build();fcRender()};
function inF(i){return sel.value==='all'||CARDS[i][0]===sel.value}
function build(){const n=Date.now();queue=CARDS.map((c,i)=>i).filter(i=>inF(i)&&(review||!sr[i]||sr[i].d<=n))}
function colOf(id){const s=SECS.find(x=>x[0]===id);return s?s[2]:'var(--blue)'}
function fcRender(){if(!queue.length&&!review&&cur===-1)build();
 const ids=CARDS.map((c,i)=>i).filter(inF);const learned=ids.filter(i=>sr[i]&&sr[i].b>=3).length;
 $('#fmeta').textContent=queue.length+' to go · '+learned+'/'+ids.length+' learned';$('#fprog').style.width=(ids.length?learned/ids.length*100:0)+'%';
 const b=$('#fbody');
 if(!queue.length){cur=-1;b.innerHTML='<div class="done"><h2>Nothing due</h2><p>You are caught up for this section.</p><button class="btn plain" id="again">Review everything again</button> <button class="btn ghost" id="reset">Reset progress</button></div>';
  $('#again').onclick=()=>{review=true;build();shown=false;fcRender()};$('#reset').onclick=()=>{sr={};save();review=false;build();fcRender()};return}
 cur=queue[0];const c=CARDS[cur],sec=SECS.find(x=>x[0]===c[0]);
 b.innerHTML=`<div class="face" id="face" style="--k:${colOf(c[0])}"><div class="tag">${sec?sec[1]:''}</div><div class="t">${c[1]}</div>${shown?`<div class="ans">${c[2]}</div>`:'<div class="hint">Tap to show the answer</div>'}</div>`+(shown?'<div class="rate"><button class="btn again" data-r="0">Again</button><button class="btn good" data-r="1">Good</button><button class="btn easy" data-r="2">Easy</button></div>':'<button class="btn plain show" id="sh" style="width:100%">Show answer</button>');
 const flip=()=>{shown=true;fcRender()};$('#face').onclick=()=>{if(!shown)flip()};const sh=$('#sh');if(sh)sh.onclick=flip;
 b.querySelectorAll('[data-r]').forEach(x=>x.onclick=()=>rate(+x.dataset.r))}
function rate(r){const i=queue.shift();const o=sr[i]||{b:0,d:0};
 if(r===0){o.b=0;o.d=Date.now();queue.push(i)}else{o.b=Math.min(5,o.b+(r===2?2:1));o.d=Date.now()+IV[o.b]*DAY}
 sr[i]=o;save();shown=false;fcRender()}
/* quiz */
const qs={i:0,score:0,done:false,started:false};
function qRender(){qs.started=true;const b=$('#qbody');
 if(qs.i>=QUIZ.length){b.innerHTML=`<div class="done"><h2>${qs.score} / ${QUIZ.length}</h2><p>Book questions finished.</p><button class="btn plain" id="qr">Try again</button></div>`;$('#qr').onclick=()=>{qs.i=0;qs.score=0;qRender()};return}
 const q=QUIZ[qs.i];b.innerHTML=`<div class="meta" style="color:var(--mute);font-weight:600;font-size:13px">Question ${qs.i+1} of ${QUIZ.length}</div><div class="qt">${q[0]}</div>`+q[1].map((o,k)=>`<button class="o" data-k="${k}">${'abcd'[k]}) ${o}</button>`).join('')+'<div id="qx"></div>';
 b.querySelectorAll('.o').forEach(el=>el.onclick=()=>{if(qs.done)return;qs.done=true;const k=+el.dataset.k;if(k===q[2])qs.score++;
  b.querySelectorAll('.o').forEach((x,j)=>{if(j===q[2])x.classList.add('ok');else if(j===k)x.classList.add('no')});
  $('#qx').innerHTML=`<div class="why"><b>Answer: ${'abcd'[q[2]]}.</b> ${q[3]}</div><button class="btn plain" id="qn" style="width:100%">${qs.i+1<QUIZ.length?'Next question':'See score'}</button>`;
  $('#qn').onclick=()=>{qs.i++;qs.done=false;qRender()}})}
</script>

</body></html>
